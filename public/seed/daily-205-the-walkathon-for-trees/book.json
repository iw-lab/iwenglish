,"audioUrl":"/seed/daily-205-the-walkathon-for-trees/audio/p3-s1.mp3","wordTimings":[{"word":"Ms","charStart":0,"charEnd":2,"startMs":0,"endMs":280},{"word":"Park","charStart":4,"charEnd":8,"startMs":460,"endMs":560},{"word":"gathered","charStart":9,"charEnd":17,"startMs":560,"endMs":960},{"word":"the","charStart":18,"charEnd":21,"startMs":960,"endMs":1260},{"word":"students","charStart":22,"charEnd":30,"startMs":1260,"endMs":1540},{"word":"near","charStart":31,"charEnd":35,"startMs":1540,"endMs":1740},{"word":"the","charStart":36,"charEnd":39,"startMs":1740,"endMs":1980},{"word":"starting","charStart":40,"charEnd":48,"startMs":1980,"endMs":2180},{"word":"line","charStart":49,"charEnd":53,"startMs":2180,"endMs":2540},{"word":"and","charStart":54,"charEnd":57,"startMs":2540,"endMs":3220},{"word":"explained","charStart":58,"charEnd":67,"startMs":3220,"endMs":3660},{"word":"the","charStart":68,"charEnd":71,"startMs":3660,"endMs":3940},{"word":"plan","charStart":72,"charEnd":76,"startMs":3940,"endMs":4160}]},{"id":"daily-205-the-walkathon-for-trees-p3-s2","ord":1,"text":"\"Every lap you walk raises money to plant trees in our neighborhood,\" she said.","translation_ko":"\"여러분이 걷는 한 바퀴마다 우리 동네에 나무를 심을 기금이 모여요,\" 선생님이 말씀하셨어요.","audioUrl":"/seed/daily-205-the-walkathon-for-trees/audio/p3-s2.mp3","wordTimings":[{"word":"Every","charStart":1,"charEnd":6,"startMs":0,"endMs":360},{"word":"lap","charStart":7,"charEnd":10,"startMs":360,"endMs":700},{"word":"you","charStart":11,"charEnd":14,"startMs":700,"endMs":960},{"word":"walk","charStart":15,"charEnd":19,"startMs":960,"endMs":1300},{"word":"raises","charStart":20,"charEnd":26,"startMs":1300,"endMs":1800},{"word":"money","charStart":27,"charEnd":32,"startMs":1800,"endMs":2120},{"word":"to","charStart":33,"charEnd":35,"startMs":2120,"endMs":2420},{"word":"plant","charStart":36,"charEnd":41,"startMs":2420,"endMs":2620},{"word":"trees","charStart":42,"charEnd":47,"startMs":2620,"endMs":3000},{"word":"in","charStart":48,"charEnd"