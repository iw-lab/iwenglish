# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예시 파일은 커밋한다 — README 와 lib/env.ts 가 이 파일을 참조하는데,
# .env* 로 통째 무시하면 클론한 사람에게 없는 파일을 가리키게 된다.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext
.open-next
.wrangler
.dev.vars

# build-time generated content
src/data/content.generated.ts

# 그림 원본 PNG는 커밋/배포 제외 — 앱은 webp만 사용(webp는 커밋함)
public/seed/**/*.png

# python 캐시(콘텐츠 생성 스크립트)
__pycache__/
*.pyc

# 비전 QA 임시 변환·codex out 캐시
.vqa-tmp/
.tqa-tmp/
**/.vision-qa-3way.json

# 로컬 육안 검수 컨택트시트(배포 제외)
public/_qa/
