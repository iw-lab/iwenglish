{"id":"daily-170-cupcakes-with-mom","slug":"daily-170-cupcakes-with-mom","title":"Cupcakes with Mom","title_ko":"엄마와 컵케이크","level":"A1","ageBand":"8-10","coverUrl":"/seed/daily-170-cupcakes-with-mom/cover.webp","summary_ko":"Jun이 엄마와 함께 맛있는 컵케이크를 만드는 즐거운 하루를 담은 이야기예요.","wordCount":101,"stage":2,"collection":"daily","pages":[{"id":"daily-170-cupcakes-with-mom-p1","pageNo":1,"spread":"p1","imageUrl":"/seed/daily-170-cupcakes-with-mom/p1.webp","sentences":[{"id":"daily-170-cupcakes-with-mom-p1-s1","ord":0,"text":"Today is Saturday.","translation_ko":"오늘은 토요일이에요.","audioUrl":"/seed/daily-170-cupcakes-with-mom/audio/p1-s1.mp3","wordTimings":[{"word":"Today","charStart":0,"charEnd":5,"startMs":0,"endMs":620},{"word":"is","charStart":6,"charEnd":8,"startMs":620,"endMs":980},{"word":"Saturday","charStart":9,"charEnd":17,"startMs":980,"endMs":1300}]},{"id":"daily-170-cupcakes-with-mom-p1-s2","ord":1,"text":"Jun and Mom are in the kitchen.","translation_ko":"Jun과 엄마는 부엌에 있어요.","audioUrl":"/seed/daily-170-cupcakes-with-mom/audio/p1-s2.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":400},{"word":"and","charStart":4,"charEnd":7,"startMs":400,"endMs":660},{"word":"Mom","charStart":8,"charEnd":11,"startMs":660,"endMs":940},{"word":"are","charStart":12,"charEnd":15,"startMs":940,"endMs":1140},{"word":"in","charStart":16,"charEnd":18,"startMs":1140,"endMs":1280},{"word":"the","charStart":19,"charEnd":22,"startMs":1280,"endMs":1560},{"word":"kitchen","charStart":23,"charEnd":30,"startMs":1560,"endMs":1620}]}]},{"id":"daily-170-cupcakes-with-mom-p2","pageNo":2,"spread":"p2","imageUrl":"/seed/daily-170-cupcakes-with-mom/p2.webp","sentences":[{"id":"daily-170-cupcakes-with-mom-p2-s1","ord":0,"text":"\"Let's make cupcakes today!\" said Mom.","translation_ko":"\"오늘 컵케이크를 만들어 보자!\" 엄마가 말했어요.","audioUrl":"/seed/daily-170-cupcakes-with-mom/audio/p2-s1.mp3","wordTimings":[{"word":"Let's","charStart":1,"charEnd":6,"startMs":0,"endMs":920},{"word":"make","charStart":7,"charEnd":11,"startMs":920,"endMs":1140},{"word":"cupcakes","charStart":12,"charEnd":20,"startMs":1140,"endMs":1560},{"word":"today","charStart":21,"charEnd":26,"startMs":1560,"endMs":2500},{"word":"said","charStart":29,"charEnd":33,"startMs":2500,"endMs":2560},{"word":"Mom","charStart":34,"charEnd":37,"startMs":2560,"endMs":2800}]},{"id":"daily-170-cupcakes-with-mom-p2-s2","ord":1,"text":"\"Yes! I love cupcakes!\" said Jun.","translation_ko":"\"좋아요! 저는 컵케이크를 정말 좋아해요!\" Jun이 말했어요.","audioUrl":"/seed/daily-170-cupcakes-with-mom/audio/p2-s2.mp3","wordTimings":[{"word":"Yes","charStart":1,"charEnd":4,"startMs":0,"endMs":460},{"word":"I","charStart":6,"charEnd":7,"startMs":820,"endMs":960},{"word":"love","charStart":8,"charEnd":12,"startMs":960,"endMs":1320},{"word":"cupcakes","charStart":13,"charEnd":21,"startMs":1320,"endMs":2440},{"word":"said","charStart":24,"charEnd":28,"startMs":2440,"endMs":2540},{"word":"Jun","charStart":29,"charEnd":32,"startMs":2540,"endMs":2840}]}]},{"id":"daily-170-cupcakes-with-mom-p3","pageNo":3,"spread":"p3","imageUrl":"/seed/daily-170-cupcakes-with-mom/p3.webp","sentences":[{"id":"daily-170-cupcakes-with-mom-p3-s1","ord":0,"text":"Mom got flour, sugar, and eggs.","translation_ko":"엄마는 밀가루, 설탕, 달걀을 가져왔어요.","audioUrl":"/seed/daily-170-cupcakes-with-mom/audio/p3-s1.mp3","wordTimings":[{"word":"Mom","charStart":0,"charEnd":3,"startMs":0,"endMs":320},{"word":"got","charStart":4,"charEnd":7,"startMs":320,"endMs":620},{"word":"flour","charStart":8,"charEnd":13,"startMs":620,"endMs":1040},{"word":"sugar","charStart":15,"charEnd":20,"startMs":1440,"endMs":1600},{"word":"and","charStart":22,"charEnd":25,"startMs":1960,"endMs":2320},{"word":"eggs","charStart":26,"charEnd":30,"startMs":2320,"endMs":2320}]},{"id":"daily-170-cupcakes-with-mom-p3-s2","ord":1,"text":"Jun put them in a big bowl.","translation_ko":"Jun은 그것들을 큰 그릇에 넣었어요.","audioUrl":"/seed/daily-170-cupcakes-with-mom/audio/p3-s2.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":400},{"word":"put","charStart":4,"charEnd":7,"startMs":400,"endMs":700},{"word":"them","charStart":8,"charEnd":12,"startMs":700,"endMs":900},{"word":"in","charStart":13,"charEnd":15,"startMs":900,"endMs":1060},{"word":"a","charStart":16,"charEnd":17,"startMs":1060,"endMs":1280},{"word":"big","charStart":18,"charEnd":21,"startMs":1280,"endMs":1540},{"word":"bowl","charStart":22,"charEnd":26,"startMs":1540,"endMs":1780}]}]},{"id":"daily-170-cupcakes-with-mom-p4","pageNo":4,"spread":"p4","imageUrl":"/seed/daily-170-cupcakes-with-mom/p4.webp","sentences":[{"id":"daily-170-cupcakes-with-mom-p4-s1","ord":0,"text":"Jun mixed the batter, but it was hard.","translation_ko":"Jun이 반죽을 저었지만, 꽤 힘들었어요.","audioUrl":"/seed/daily-170-cupcakes-with-mom/audio/p4-s1.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":540},{"word":"mixed","charStart":4,"charEnd":9,"startMs":540,"endMs":980},{"word":"the","charStart":10,"charEnd":13,"startMs":980,"endMs":1260},{"word":"batter","charStart":14,"charEnd":20,"startMs":1260,"endMs":1520},{"word":"but","charStart":22,"charEnd":25,"startMs":1800,"endMs":2080},{"word":"it","charStart":26,"charEnd":28,"startMs":2080,"endMs":2180},{"word":"was","charStart":29,"charEnd":32,"startMs":2180,"endMs":2380},{"word":"hard","charStart":33,"charEnd":37,"startMs":2380,"endMs":2680}]},{"id":"daily-170-cupcakes-with-mom-p4-s2","ord":1,"text":"Mom helped him and smiled.","translation_ko":"엄마가 Jun을 도와주며 미소 지었어요.","audioUrl":"/seed/daily-170-cupcakes-with-mom/audio/p4-s2.mp3","wordTimings":[{"word":"Mom","charStart":0,"charEnd":3,"startMs":0,"endMs":520},{"word":"helped","charStart":4,"charEnd":10,"startMs":520,"endMs":880},{"word":"him","charStart":11,"charEnd":14,"startMs":880,"endMs":1140},{"word":"and","charStart":15,"charEnd":18,"startMs":1140,"endMs":1560},{"word":"smiled","charStart":19,"charEnd":25,"startMs":1560,"endMs":1920}]}]},{"id":"daily-170-cupcakes-with-mom-p5","pageNo":5,"spread":"p5","imageUrl