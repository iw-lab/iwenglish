{"id":"the-chick-who-was-late","slug":"the-chick-who-was-late","title":"The Chick Who Was Late","title_ko":"늦잠 잔 병아리","level":"A1","ageBand":"8-10","coverUrl":"/seed/the-chick-who-was-late/cover.webp","summary_ko":"늦잠을 잔 병아리가 서둘러 친구들을 따라가며 시간 약속을 배우는 이야기.","wordCount":123,"pages":[{"id":"the-chick-who-was-late-p1","pageNo":1,"spread":"p1","imageUrl":"/seed/the-chick-who-was-late/p1.webp","sentences":[{"id":"the-chick-who-was-late-p1-s1","ord":0,"text":"The little chick slept and slept.","translation_ko":"작은 병아리는 계속 잠을 잤어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p1-s1.mp3","wordTimings":[{"word":"The","charStart":0,"charEnd":3,"startMs":0,"endMs":780},{"word":"little","charStart":4,"charEnd":10,"startMs":780,"endMs":1100},{"word":"chick","charStart":11,"charEnd":16,"startMs":1100,"endMs":1400},{"word":"slept","charStart":17,"charEnd":22,"startMs":1400,"endMs":1960},{"word":"and","charStart":23,"charEnd":26,"startMs":1960,"endMs":2520},{"word":"slept","charStart":27,"charEnd":32,"startMs":2520,"endMs":2780}]},{"id":"the-chick-who-was-late-p1-s2","ord":1,"text":"The sun came up but he did not wake.","translation_ko":"해가 떴지만 병아리는 일어나지 않았어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p1-s2.mp3","wordTimings":[{"word":"The","charStart":0,"charEnd":3,"startMs":0,"endMs":260},{"word":"sun","charStart":4,"charEnd":7,"startMs":260,"endMs":640},{"word":"came","charStart":8,"charEnd":12,"startMs":640,"endMs":1120},{"word":"up","charStart":13,"charEnd":15,"startMs":1120,"endMs":1380},{"word":"but","charStart":16,"charEnd":19,"startMs":1880,"endMs":2000},{"word":"he","charStart":20,"charEnd":22,"startMs":2000,"endMs":2160},{"word":"did","charStart":23,"charEnd":26,"startMs":2160,"endMs":2340},{"word":"not","charStart":27,"charEnd":30,"startMs":2340,"endMs":2620},{"word":"wake","charStart":31,"charEnd":35,"startMs":2620,"endMs":2880}]}]},{"id":"the-chick-who-was-late-p2","pageNo":2,"spread":"p2","imageUrl":"/seed/the-chick-who-was-late/p2.webp","sentences":[{"id":"the-chick-who-was-late-p2-s1","ord":0,"text":"All the friends went to the meadow.","translation_ko":"친구들은 모두 풀밭으로 떠났어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p2-s1.mp3","wordTimings":[{"word":"All","charStart":0,"charEnd":3,"startMs":0,"endMs":520},{"word":"the","charStart":4,"charEnd":7,"startMs":520,"endMs":720},{"word":"friends","charStart":8,"charEnd":15,"startMs":720,"endMs":1000},{"word":"went","charStart":16,"charEnd":20,"startMs":1000,"endMs":1240},{"word":"to","charStart":21,"charEnd":23,"startMs":1240,"endMs":1400},{"word":"the","charStart":24,"charEnd":27,"startMs":1400,"endMs":1640},{"word":"meadow","charStart":28,"charEnd":34,"startMs":1640,"endMs":1680}]},{"id":"the-chick-who-was-late-p2-s2","ord":1,"text":"They called for him but he was asleep.","translation_ko":"친구들이 불렀지만 병아리는 자고 있었어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p2-s2.mp3","wordTimings":[{"word":"They","charStart":0,"charEnd":4,"startMs":0,"endMs":320},{"word":"called","charStart":5,"charEnd":11,"startMs":320,"endMs":620},{"word":"for","charStart":12,"charEnd":15,"startMs":620,"endMs":880},{"word":"him","charStart":16,"charEnd":19,"startMs":880,"endMs":1060},{"word":"but","charStart":20,"charEnd":23,"startMs":1240,"endMs":1340},{"word":"he","charStart":24,"charEnd":26,"startMs":1340,"endMs":1500},{"word":"was","charStart":27,"charEnd":30,"startMs":1500,"endMs":1640},{"word":"asleep","charStart":31,"charEnd":37,"startMs":1640,"endMs":2100}]}]},{"id":"the-chick-who-was-late-p3","pageNo":3,"spread":"p3","imageUrl":"/seed/the-chick-who-was-late/p3.webp","sentences":[{"id":"the-chick-who-was-late-p3-s1","ord":0,"text":"At last the chick opened his eyes.","translation_ko":"마침내 병아리가 눈을 떴어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p3-s1.mp3","wordTimings":[{"word":"At","charStart":0,"charEnd":2,"startMs":0,"endMs":240},{"word":"last","charStart":3,"charEnd":7,"startMs":240,"endMs":680},{"word":"the","charStart":8,"charEnd":11,"startMs":980,"endMs":1360},{"word":"chick","charStart":12,"charEnd":17,"startMs":1360,"endMs":1380},{"word":"opened","charStart":18,"charEnd":24,"startMs":1380,"endMs":1800},{"word":"his","charStart":25,"charEnd":28,"startMs":1800,"endMs":2080},{"word":"eyes","charStart":29,"charEnd":33,"startMs":2080,"endMs":2380}]},{"id":"the-chick-who-was-late-p3-s2","ord":1,"text":"He looked around but no one was there.","translation_ko":"주위를 둘러봤지만 아무도 없었어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p3-s2.mp3","wordTimings":[{"word":"He","charStart":0,"charEnd":2,"startMs":0,"endMs":200},{"word":"looked","charStart":3,"charEnd":9,"startMs":200,"endMs":380},{"word":"around","charStart":10,"charEnd":16,"startMs":380,"endMs":780},{"word":"but","charStart":17,"charEnd":20,"startMs":1100,"endMs":1260},{"word":"no","charStart":21,"charEnd":23,"startMs":1260,"endMs":1480},{"word":"one","charStart":24,"charEnd":27,"startMs":1480,"endMs":1620},{"word":"was","charStart":28,"charEnd":31,"startMs":1620,"endMs":1820},{"word":"there","charStart":32,"charEnd":37,"startMs":1820,"endMs":2060}]}]},{"id":"the-chick-who-was-late-p4","pageNo":4,"spread":"p4","imageUrl":"/seed/the-chick-who-was-late/p4.webp","sentences":[{"id":"the-chick-who-was-late-p4-s1","ord":0,"text":"\"Where did everyone go?\" he said.","translation_ko":"\"모두 어디 간 거지?\" 병아리가 말했어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p4-s1.mp3","wordTimings":[{"word":"Where","charStart":1,"charEnd":6,"startMs":0,"endMs":320},{"word":"did","charStart":7,"charEnd":10,"startMs":320,"endMs":560},{"word":"everyone","charStart":11,"charEnd":19,"startMs":560,"endMs":1040},{"word":"go","charStart":20,"charEnd":22,"startMs":1040,"endMs":1620},{"word":"he","charStart":25,"charEnd":27,"startMs":1620,"endMs":1840},{"word":"said","charStart":28,"charEnd":32,"startMs":1840,"endMs":2060}]}]},{"id":"the-chick-who-was-late-p5","pageNo":5,"spread":"p5","imageUrl":"/seed/the-chick-who-was-late/p5.webp","sentences":[{"id":"the-chick-who-was-late-p5-s1","ord":0,"text":"He ran fast down the little path.","translation_ko":"병아리는 좁은 길을 빠르게 달렸어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p5-s1.mp3","wordTimings":[{"word":"He","charStart":0,"charEnd":2,"startMs":0,"endMs":300},{"word":"ran","charStart":3,"charEnd":6,"startMs":300,"endMs":580},{"word":"fast","charStart":7,"charEnd":11,"startMs":580,"endMs":1200},{"word":"down","charStart":12,"charEnd":16,"startMs":1200,"endMs":1560},{"word":"the","charStart":17,"charEnd":20,"startMs":1560,"endMs":1760},{"word":"little","charStart":21,"charEnd":27,"startMs":1760,"endMs":1980},{"word":"path","charStart":28,"charEnd":32,"startMs":1980,"endMs":2320}]},{"id":"the-chick-who-was-late-p5-s2","ord":1,"text":"His legs hurt and he was tired.","translation_ko":"다리가 아프고 무척 피곤했어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p5-s2.mp3","wordTimings":[{"word":"His","charStart":0,"charEnd":3,"startMs":0,"endMs":280},{"word":"legs","charStart":4,"charEnd":8,"startMs":280,"endMs":520},{"word":"hurt","charStart":9,"charEnd":13,"startMs":520,"endMs":900},{"word":"and","charStart":14,"charEnd":17,"startMs":1300,"endMs":1360},{"word":"he","charStart":18,"charEnd":20,"startMs":1360,"endMs":1480},{"word":"was","charStart":21,"charEnd":24,"startMs":1480,"endMs":1680},{"word":"tired","charStart":25,"charEnd":30,"startMs":1680,"endMs":1980}]}]},{"id":"the-chick-who-was-late-p6","pageNo":6,"spread":"p6","imageUrl":"/seed/the-chick-who-was-late/p6.webp","sentences":[{"id":"the-chick-who-was-late-p6-s1","ord":0,"text":"He saw his friends by the big tree.","translation_ko":"커다란 나무 곁에서 친구들을 발견했어요.","audioUrl":"/seed/the-chick-who-was-late/audio/p6-s1.mp3","wordTimings":[{"word":"He","charStart":0,"charEnd":2,"startMs":0,"endMs":180},{"word":"saw","charStart":3,"charEnd":6,"startMs":180,"endMs":480},{"word":"his","charStart":7,"charEnd":10,"startMs":480,"endMs":780},{"word":"friends","charStart":11,"charEnd":18,"startMs":780,"endMs":1100},{"word":"by","charStart":19,"charEnd":21,"startMs":1100,"endMs":1380},{"word":"the","charStart":