# ─────────────────────────────────────────────────────────────
# EchoTale 환경변수 — 이 파일을 `.env.local` 로 복사해서 값을 채웁니다.
#   cp .env.local.example .env.local
# ⚠️ .env.local 은 git 에 커밋되지 않습니다 (키 하드코딩 금지)
#
# 👉 앱을 그냥 실행하는 데는 **키가 하나도 필요 없습니다.**
#    배포된 앱은 생성이 끝난 정적 자산만 재생하므로 런타임 AI 호출이 없습니다.
#    아래 값은 "콘텐츠를 새로 생성"하거나 "선택 기능"을 켤 때만 씁니다.
# ─────────────────────────────────────────────────────────────

# ── 콘텐츠(에셋) 생성용 — 앱 실행에는 불필요 ──────────────────
# OpenAI: 낭독·단어 음성(gpt-4o-mini-tts) + 단어 뜻(gpt-4o-mini) + 정렬(whisper-1)
#   scripts/gen-audio.ts, gen-word-audio.ts, gen-word-dict.ts 에서만 사용합니다.
#   ※ 일러스트는 OpenAI Codex CLI 의 $imagegen 도구로 생성하며 이 키를 쓰지 않습니다.
OPENAI_API_KEY=

# 사전 API: dictionaryapi.dev — 키 불필요(무료).
#   정적 사전(public/dict.json)에 없는 단어의 폴백 조회에만 씁니다.

# ── 선택 기능 ────────────────────────────────────────────────
# MyVoice OS (선생님 목소리 낭독, OpenAI 호환 엔드포인트).
# 비워 두면 미리 생성된 음성으로 정상 동작합니다.
MYVOICE_BASE_URL=
MYVOICE_API_KEY=

# ── 운영 모드 플래그 ─────────────────────────────────────────
# 교실용 = false (전 기능 무료 개방). 결제 연동은 아직 구현되어 있지 않습니다.
NEXT_PUBLIC_BILLING_ENABLED=false

# ─────────────────────────────────────────────────────────────
# 콘텐츠 생성 스크립트 옵션 (scripts/ 실행 시에만, 전부 선택)
#   TTS_ENGINE=openai|edge                음성 엔진 (기본 openai)
#   OPENAI_TTS_MODEL / OPENAI_TTS_VOICE   기본 gpt-4o-mini-tts / nova
#   EDGE_TTS_VOICE                        edge 엔진일 때 목소리
#   CONC=3                                동시 생성 수
#   ONLY=<slug>                           특정 책만 처리
#   FORCE=1                               이미 있는 산출물도 다시 생성
#   SKIP_WHISPER=1                        단어 타임스탬프 정렬 건너뛰기
# ─────────────────────────────────────────────────────────────
