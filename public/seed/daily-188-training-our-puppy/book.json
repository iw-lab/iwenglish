,"charEnd":31,"startMs":2040,"endMs":2320},{"word":"everywhere","charStart":32,"charEnd":42,"startMs":2320,"endMs":2920}]}]},{"id":"daily-188-training-our-puppy-p2","pageNo":2,"spread":"p2","imageUrl":"/seed/daily-188-training-our-puppy/p2.webp","sentences":[{"id":"daily-188-training-our-puppy-p2-s1","ord":0,"text":"Mom said, \"We need to train Coco today.\"","translation_ko":"엄마가 말했어요. \"오늘 코코를 훈련시켜야 해.\"","audioUrl":"/seed/daily-188-training-our-puppy/audio/p2-s1.mp3","wordTimings":[{"word":"Mom","charStart":0,"charEnd":3,"startMs":0,"endMs":440},{"word":"said","charStart":4,"charEnd":8,"startMs":440,"endMs":840},{"word":"We","charStart":11,"charEnd":13,"startMs":1220,"endMs":1360},{"word":"need","charStart":14,"charEnd":18,"startMs":1360,"endMs":1540},{"word":"to","charStart":19,"charEnd":21,"startMs":1540,"endMs":1780},{"word":"train","charStart":22,"charEnd":27,"startMs":1780,"endMs":1980},{"word":"Coco","charStart":28,"charEnd":32,"startMs":1980,"endMs":2340},{"word":"today","charStart":33,"charEnd":38,"startMs":2340,"endMs":2780}]},{"id":"daily-188-training-our-puppy-p2-s2","ord":1,"text":"Jun said, \"I want to help teach her!\"","translation_ko":"Jun이 말했어요. \"제가 가르치는 걸 도와드릴게요!\"","audioUrl":"/seed/daily-188-training-our-puppy/audio/p2-s2.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":320},{"word":"said","charStart":4,"charEnd":8,"startMs":320,"endMs":700},{"word":"I","charStart":11,"charEnd":12,"startMs":1080,"endMs":1180},{"word":"want","charStart":13,"charEnd":17,"startMs":1180,"endMs":1380},{"word":"to","charStart":18,"charEnd":20,"startMs":1380,"endMs":1580},{"word":"help","charStart":21,"charEnd":25,"startMs":1580,"endMs":1720},{"word":"teach","charStart":26,"charEnd":31,"startMs":1720,"endMs":2080},{"word":"her","charStart":32,"charEnd":35,"startMs":2080,"endMs":2260}]}]},{"id":"daily-188-training-our-puppy-p3","pageNo":3,"spread":"p3","imageUrl":"/seed/daily-188-training-our-puppy/p3.webp","sentences":[{"id":"daily-188-training-our-puppy-p3-s1","ord":0,"text":"First, Mom showed Jun how to give a command.","translation_ko":"먼저 엄마가 Jun에게 명령하는 방법을 알려줬어요.","audioUrl":"/seed/daily-188-training-our-puppy/audio/p3-s1.mp3","wordTimings":[{"word":"First","charStart":0,"charEnd":5,"startMs":0,"endMs":780},{"word":"Mom","charStart":7,"charEnd":10,"startMs":960,"endMs":1260},{"word":"showed","charStart":11,"charEnd":17,"startMs":1260,"endMs":1540},{"word":"Jun","charStart":18,"charEnd":21,"startMs":1540,"endMs":1820},{"word":"how","charStart":22,"charEnd":25,"startMs":1820,"endMs":2060},{"word":"to","charStart":26,"charEnd":28,"startMs":2060,"endMs":2220},{"word":"give","charStart":29,"charEnd":33,"startMs":2220,"endMs":2300},{"word":"a","charStart":34,"charEnd":35,"startMs":2300,"endMs":2760},{"word":"command","charStart":36,"charEnd":43,"startMs":2760,"endMs":2760}]},{"id":"daily-188-training-our-puppy-p3-s2","ord":1,"text":"She held a small treat and said, \"Sit!\"","translation_ko":"엄마는 간식을 들고 '앉아!'라고 말했어요.","audioUrl":"/seed/daily-188-training-our-puppy/audio/p3-s2.mp3","wordTimings":[{"word":"She","charStart":0,"charEnd":3,"startMs":0,"endMs":300},{"word":"held","charStart":4,"charEnd":8,"startMs":300,"endMs":580},{"word":"a","charStart":9,"charEnd":10,"startMs":580,"endMs":920},{"word":"small","charStart":11,"charEnd":16,"startMs":920,"endMs":1240},{"word":"treat","charStart":17,"charEnd":22,"startMs":1240,"endMs":1600},{"word":"and","charStart":23,"charEnd":26,"startMs":1600,"endMs":2040},{"word":"said","charStart":27,"charEnd":31,"startMs":2040,"endMs":2260},{"word":"Sit","charStart":34,"charEnd":37,"startMs":2400,"endMs":2780}]}]},{"id":"daily-188-training-our-puppy-p4","pageNo":4,"spread":"p4","imageUrl":"/seed/daily-188-training-our-puppy/p4.webp","sentences":[{"id":"daily-188-training-our-puppy-p4-s1","ord":0,"text":"Coco wagged her tail but did not sit down.","translation_ko":"코코는 꼬리를 흔들었지만 앉지는 않았어요.","audioUrl":"/seed/daily-188-training-our-puppy/audio/p4-s1.mp3","wordTimings"