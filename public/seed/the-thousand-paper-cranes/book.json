"charEnd":25,"startMs":826,"endMs":1501},{"word":"nine","charStart":28,"charEnd":32,"startMs":1501,"endMs":1734},{"word":"hundred","charStart":33,"charEnd":40,"startMs":1734,"endMs":2141},{"word":"and","charStart":41,"charEnd":44,"startMs":2141,"endMs":2374},{"word":"ninety-nine","charStart":45,"charEnd":56,"startMs":2374,"endMs":3127},{"word":"to","charStart":57,"charEnd":59,"startMs":3127,"endMs":3361},{"word":"go","charStart":60,"charEnd":62,"startMs":3361,"endMs":3750}]}]},{"id":"the-thousand-paper-cranes-p3","pageNo":3,"spread":"p3","imageUrl":"/seed/the-thousand-paper-cranes/p3.webp","sentences":[{"id":"the-thousand-paper-cranes-p3-s1","ord":0,"text":"Her best friend, Sora, had been in the hospital for three weeks.","translation_ko":"그녀의 가장 친한 친구 소라는 병원에 입원한 지 벌써 삼 주가 되었습니다.","audioUrl":"/seed/the-thousand-paper-cranes/audio/p3-s1.mp3","wordTimings":[{"word":"Her","charStart":0,"charEnd":3,"startMs":0,"endMs":220},{"word":"best","charStart":4,"charEnd":8,"startMs":220,"endMs":560},{"word":"friend","charStart":9,"charEnd":15,"startMs":560,"endMs":1000},{"word":"Sora","charStart":17,"charEnd":21,"startMs":1300,"endMs":1580},{"word":"had","charStart":23,"charEnd":26,"startMs":2160,"endMs":2300},{"word":"been","charStart":27,"charEnd":31,"startMs":2300,"endMs":2420},{"word":"in","charStart":32,"charEnd":34,"startMs":2420,"endMs":2600},{"word":"the","charStart":35,"charEnd":38,"startMs":2600,"endMs":2820},{"word":"hospital","charStart":39,"charEnd":47,"startMs":2820,"endMs":3040},{"word":"for","charStart":48,"charEnd":51,"startMs":3040,"endMs":3380},{"word":"three","charStart":52,"charEnd":57,"startMs":3380,"endMs":3700},{"word":"weeks","charStart":58,"charEnd":63,"startMs":3700,"endMs":4020}]},{"id":"the-thousand-paper-cranes-p3-s2","ord":1,"text":"Sora loved cranes, and an old legend said a thousand cranes brought a wish.","translation_ko":"소라는 학을 무척 좋아했고, 옛 전설에 따르면 천 마리 학은 소원을 이루어 준다고 했습니다.","audioUrl":"/seed/the-thousand-paper-cranes/audio/p3-s2.mp3","wordTimings":[{"word":"Sora","charStart":0,"charEnd":4,"startMs":0,"endMs":460},{"word":"loved","charStart":5,"charEnd":10,"startMs":460,"endMs":860},{"word":"cranes","charStart":11,"charEnd":17,"startMs":860,"endMs":1220},{"word":"and","charStart":19,"charEnd":22,"startMs":1840,"endMs":1880},{"word":"an","charStart":23,"charEnd":25,"startMs":1880,"endMs":2140},{"word":"old","charStart":26,"charEnd":29,"startMs":2140,"endMs":2360},{"word":"legend","charStart":30,"charEnd":36,"startMs":2360,"endMs":2620},{"word":"said","charStart":37,"charEnd":41,"startMs":2620,"endMs":3000},{"word":"a","charStart":42,"charEnd":43,"startMs":3000,"endMs":3240},{"word":"thousand","charStart":44,"charEnd":52,"startMs":3240,"endMs":3600},{"word":"cranes","charStart":53,"charEnd":59,"startMs":3600,"endMs":4000},{"word":"brought","charStart":60,"charEnd":67,"startMs":4000,"endMs":4360},{"word":"a","charStart":68,"charEnd":69,"startMs":4360,"endMs":4740},{"word":"wish","charStart":70,"charEnd":74,"startMs":4740,"endMs":4740}]}]},{"id":"the-thousand-paper-cranes-p4","pageNo":4,"spread":"p4","imageUrl":"/seed/the-thousand-paper-cranes/p4.webp","sentences":[{"id":"the-thousand-paper-cranes-p4-s1","ord":0,"text":"Mia had made up her mind: she would fold every single one.","translation_ko":"미아는 마음을 굳혔습니다. 한 마리도 빠짐없이 직접 접겠다고.","audioUrl":"/seed/the-thousand-paper-cranes/audio/p4-s1.mp3","wordTimings":[{"word":"Mia","charStart":0,"charEnd":3,"startMs":0,"endMs":380},{"word":"had","charStart":4,"charEnd":7,"startMs":380,"endMs":660},{"word":"made","charStart":8,"charEnd":12,"startMs":660,"endMs":820},{"word":"up","charStart":13,"charEnd":15,"startMs":820,"endMs":980},{"word":"her","charStart":16,"charEnd":19,"startMs":980,"endMs":1160},{"word":"mind","charStart":20,"charEnd":24,"startMs":1160,"endMs":1440},{"word":"she","charStart":26,"charEnd":29,"startMs":1860,"endMs":2100},{"word":"would","charStart":30,"charEnd":35,"startMs":2100,"endMs":2320},{"word":"fold","charStart":36,"charEnd":40,"startMs":2320,"endMs":2660},{"word":"every","charStart":41,"charEnd":46,"startMs":2660,"endMs":3260},{"word":"single","charStart":47,"charEnd":53,"startMs":3260,"endMs":3560},{"word":"one","charStart":54,"charEnd":57,"startMs":3560,"endMs":3840}]},{"id":"the-thousand-paper-cranes-p4-s2","ord":1,"text":"\"I will get this done,\" she told herself firmly.","translation_ko":"\"반드시 해낼 거야,\" 그녀는 스스로에게 다짐했습니다.","audioUrl":"/seed/the-thousand-paper-cranes/audio/p4-s2.mp3","wordTimings":[{"word":"I","charStart":1,"charEnd":2,"startMs":0,"endMs":320},{"word":"will","charStart":3,"charEnd":7,"startMs":320,"endMs":640},{"word":"get","charStart":8,"charEnd":11,"startMs":640,"endMs":880},{"word":"this","charStart":12,"charEnd":16,"startMs":880,"endMs":1280},{"word":"done","charStart":17,"charEnd":21,"startMs":1280,"endMs":1560},{"word":"she","charStart":24,"charEnd":27,"startMs":1880,"endMs":2020},{"word":"told","charStart":28,"charEnd":32,"startMs":2020,"endMs":2240},{"word":"herself","charStart":33,"charEnd":40,"startMs":2240,"endMs":2640},{"word":"firmly","charStart":41,"charEnd":47,"startMs":2640,"endMs":3040}]}]},{"id":"the-thousand-paper-cranes-p5","pageNo":5,"spread":"p5","imageUrl":"/seed/the-thousand-paper-cranes/p5.webp","sentences":[{"id":"the-thousand-paper-cranes-p5-s1","ord":0,"text":"Days passed, and her stack of cranes grew slowly.","translation_ko":"날이 지날수록 학 무더기는 조금씩 쌓여 갔습니다.","audioUrl":"/seed/the-thousand-paper-cranes/audio/p5-s1.mp3","wordTimings":[{"word":"Days","charStart":0,"charEnd":4,"startMs":0,"endMs":380},{"word":"passed","charStart":5,"charEnd":11,"startMs":380,"endMs":880},{"word":"and","charStart":13,"charEnd":16,"startMs":1340,"endMs":1420},{"word":"her","charStart":17,"charEnd":20,"startMs":1420,"endMs":1640},{"word":"stack","charStart":21,"charEnd":26,"startMs":1640,"endMs":1880},{"word":"of","charStart":27,"charEnd":29,"startMs":1880,"endMs":2440},{"word":"cranes","charStart":30,"charEnd":36,"startMs":2440,"endMs":2440},{"word":"grew","charStart":37,"charEnd":41,"startMs":2440,"endMs":2740},{"word":"slowly","charStart":42,"charEnd":48,"startMs":2740,"endMs":3160}]},{"id":"the-thousand-paper-cranes-p5-s2","ord":1,"text":"But after a week, she had only folded eighty-three.","translation_ko":"그러나 일주일이 지나도 그녀가 접은 건 고작 여든세 마리뿐이었습니다.","audioUrl":"/seed/the-thousand-paper-cranes/audio/p5-s2.mp3","wordTimings":[{"word":"But","charStart":0,"charEnd":3,"startMs":0,"endMs":640},{"word":"after","charStart":4,"charEnd":9,"startMs":640,"endMs":960},{"word":"a","charStart":10,"charEnd":11,"startMs":960,"endMs":1240},{"word":"week","charStart":12,"charEnd":16,"startMs":1240,"endMs":1400},{"word":"she","charStart":18,"charEnd":21,"startMs":1660,"endMs":1820},{"word":"had","charStart":22,"charEnd":25,"startMs":1820,"endMs":1960},{"word":"only","charStart":26,"charEnd":30,"startMs":1960,"endMs":2320},{"word":"folded","charStart":31,"charEnd":37,"startMs":2320,"endMs":2600},{"word":"eighty-three","charStart":38,"charEnd":50,"startMs":2600,"endMs":3100}]},{"id":"the-thousand-paper-cranes-p5-s3","ord":2,"text":"Her hands ached, and doubt crept into her heart.","translation_ko":"손이 욱신거렸고, 마음속에 의심이 스며들었습니다.","audioUrl":"/seed/the-thousand-paper-cranes/audio/p5-s3.mp3","wordTimings":[{"word":"Her","charStart":0,"charEnd":3,"startMs":0,"endMs":360},{"word":"hands","charStart":4,"charEnd":9,"startMs":360,"endMs":740},{"word":"ached","charStart":10,"charEnd":15,"startMs":740,"endMs":1200},{"word":"and","charStart":17,"charEnd":20,"startMs":1200,"endMs":1940},{"word":"doubt","charStart":21,"charEnd":26,"startMs":1940,"endMs":2160},{"word":"crept","charStart":27,"charEnd":32,"startMs":2160,"endMs":2520},{"word":"into","charStart":33,"charEnd":37,"startMs":2520,"endMs":2760},{"word":"her","charStart":38,"charEnd":41,"startMs":2760,"endMs":3060},{"word":"heart","charStart":42,"charEnd":47,"startMs":3060,"endMs":3280}]}]},{"id":"the-thousand-paper-cranes-p6","pageNo":6,"spread":"p6","imageUrl":"/seed/the-thousand-paper-cranes/p6.webp","sentences":[{"id":"the-thousand-paper-cranes-p6-s1","ord":0,"text":"One morning, her classmate Jin watched her working at lunch.","translation_ko":"어느 날 아침, 같은 반 친구 진이 점심시간에 그녀가 일하는 것을 지켜보았습니다.","audioUrl":"/seed/the-thousand-paper-cranes/audio/p6-s1.mp3","wordTimings":[{"word":"One","charStart":0,"charEnd":3,"startMs":0,"endMs":300},{"word":"morning","charStart":4,"charEnd":11,"startMs":300,"endMs":660},{"word":"her","charStart":13,"charEnd":16,"startMs":1100,"endMs":1300},{"word":"classmate","charStart":17,"charEnd":26,"startMs":1300,"endMs":1820},{"word":"Jin","charStart":27,"charEnd":30,"startMs":1820,"endMs":2060},{"word":"watched","charStart":31,"charEnd":38,"startMs":2060,"endMs":2580},{"word":"her","charStart":39,"charEnd":42,"startMs":2580,"endMs":2800},{"word":"working","charStart":43,"charEnd":50,"startMs":2800,"endMs":3100},{"word":"at","charStart":51,"charEnd":53,"startMs":3100,"endMs":3300},{"word":"lunch","charStart":54,"charEnd":59,"startMs":3300,"endMs":3540}]},{"id":"the-thousand-paper-cranes-p6-s2","ord":1,"text":"\"Can I try?\" he asked, picking up a sheet of paper.","translation_ko":"\"나도 해도 돼?\" 그가 종이 한 장을 집어 들며 물었습니다.","audioUrl":"/seed/the-thousand-paper-cranes/audio/p6-s2.mp3","wordTimings":[{"word":"Can","charStart":1,"charEnd":4,"startMs":0,"endMs":560},{"word":"I","charStart":5,"charEnd":6,"startMs":560,"endMs":760},{"word":"try","charStart":7,"charEnd":10,"startMs":760,"endMs":1060},{"word":"he","charStart":13,"charEnd":15,"startMs":1240,"endMs":1500},{"word":"asked","charStart":16,"charEnd":21,"startMs":1500,"endMs":1820},{"word":"picking","charStart":23,"charEnd":30,"startMs":2240,"endMs":2400},{"word":"up","charStart":31,"charEnd":33,"startMs":2400,"endMs":2560},{"word":"a","charStart":34,"charEnd":35,"startMs":2560,"endMs":2760},{"word":"sheet","charStart":36,"charEnd":41,"startMs":2760,"endMs":2840},{"word":"of","charStart":42,"charEnd":44,"startMs":2840,"endMs":3300},{"word":"paper","charStart":45,"charEnd":50,"startMs":3300,"endMs":3300}]}]},{"id"