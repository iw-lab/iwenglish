p3","wordTimings":[{"word":"Mr","charStart":0,"charEnd":2,"startMs":0,"endMs":380},{"word":"Ellis","charStart":4,"charEnd":9,"startMs":740,"endMs":800},{"word":"nodded","charStart":10,"charEnd":16,"startMs":800,"endMs":1300},{"word":"slowly","charStart":17,"charEnd":23,"startMs":1300,"endMs":1740},{"word":"and","charStart":24,"charEnd":27,"startMs":1740,"endMs":2240},{"word":"set","charStart":28,"charEnd":31,"startMs":2240,"endMs":2420},{"word":"down","charStart":32,"charEnd":36,"startMs":2420,"endMs":2660},{"word":"his","charStart":37,"charEnd":40,"startMs":2660,"endMs":2860},{"word":"book","charStart":41,"charEnd":45,"startMs":2860,"endMs":3080}]},{"id":"the-last-bookshop-in-the-rain-p4-s3","ord":2,"text":"\"Nobody comes here anymore, dear girl.\"","translation_ko":"\"이제 아무도 여기 오지 않는단다, 얘야.\"","audioUrl":"/seed/the-last-bookshop-in-the-rain/audio/p4-s3.mp3","wordTimings":[{"word":"Nobody","charStart":1,"charEnd":7,"startMs":0,"endMs":660},{"word":"comes","charStart":8,"charEnd":13,"startMs":660,"endMs":1100},{"word":"here","charStart":14,"charEnd":18,"startMs":1100,"endMs":1380},{"word":"anymore","charStart":19,"charEnd":26,"startMs":1380,"endMs":1840},{"word":"dear","charStart":28,"charEnd":32,"startMs":2360,"endMs":2500},{"word":"girl","charStart":33,"charEnd":37,"startMs":2500,"endMs":2740}]}]},{"id":"the-last-bookshop-in-the-rain-p5","pageNo":5,"spread":"p5","imageUrl":"/seed/the-last-bookshop-in-the-rain/p5.webp","sentences":[{"id":"the-last-bookshop-in-the-rain-p5-s1","ord":0,"text":"Mia thought for a long moment and then looked up.","translation_ko":"미아는 한참 생각하다가 고개를 들었습니다.","audioUrl":"/seed/the-last-bookshop-in-the-rain/audio/p5-s1.mp3","wordTimings":[{"word":"Mia","charStart":0,"charEnd":3,"startMs":0,"endMs":460},{"word":"thought","charStart":4,"charEnd":11,"startMs":460,"endMs":900},{"word":"for","charStart":12,"charEnd":15,"startMs":900,"endMs":1100},{"word":"a","charStart":16,"charEnd":17,"startMs":1100,"endMs":1320},{"word":"long","charStart":18,"ch