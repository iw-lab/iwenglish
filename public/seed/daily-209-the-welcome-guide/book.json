 사귀는 방법에 대한 팁을 적었어요.","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p7-s1.mp3","wordTimings":[{"word":"Next","charStart":0,"charEnd":4,"startMs":0,"endMs":440},{"word":"they","charStart":6,"charEnd":10,"startMs":880,"endMs":1240},{"word":"wrote","charStart":11,"charEnd":16,"startMs":1240,"endMs":1420},{"word":"tips","charStart":17,"charEnd":21,"startMs":1420,"endMs":1840},{"word":"about","charStart":22,"charEnd":27,"startMs":1840,"endMs":2260},{"word":"how","charStart":28,"charEnd":31,"startMs":2260,"endMs":2440},{"word":"to","charStart":32,"charEnd":34,"startMs":2440,"endMs":2600},{"word":"make","charStart":35,"charEnd":39,"startMs":2600,"endMs":2780},{"word":"friends","charStart":40,"charEnd":47,"startMs":2780,"endMs":3060},{"word":"quickly","charStart":48,"charEnd":55,"startMs":3060,"endMs":3460}]},{"id":"daily-209-the-welcome-guide-p7-s2","ord":1,"text":"\"Say hello first and offer to share your lunch,\" Jun wrote.","translation_ko":"\"먼저 인사하고 점심을 나눠 먹자고 해봐.\" 준이 적었어요.","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p7-s2.mp3","wordTimings":[{"word":"Say","charStart":1,"charEnd":4,"startMs":0,"endMs":360},{"word":"hello","charStart":5,"charEnd":10,"startMs":360,"endMs":780},{"word":"first","charStart":11,"charEnd":16,"startMs":780,"endMs":1320},{"word":"and","charStart":17,"charEnd":20,"startMs":1760,"endMs":1840},{"word":"offer","charStart":21,"charEnd":26,"startMs":1840,"endMs":2120},{"word":"to","charStart":27,"charEnd":29,"startMs":2120,"endMs":2400},{"word":"share","charStart":30,"charEnd":35,"startMs":2400,"endMs":2560},{"word":"your","charStart":36,"charEnd":40,"startMs":2560,"endMs":2860},{"word":"lunch","charStart":41,"charEnd":46,"startMs":2860,"endMs":3520},{"word":"Jun","charStart":49,"charEnd":52,"startMs":3520,"endMs":3800},{"word":"wrote","charStart":53,"charEnd":58,"startMs":3800,"endMs":4080}]},{"id":"daily-209-the-welcome-guide-p7-s3","ord":2,"text":"Mina added, \"Joining a club is also a great way to meet people.\"","translation_ko":"미나가 덧붙였어요. \"동아리에 가입하는 것도 사람을 만나는 좋은 방법이야.\"","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p7-s3.mp3","wordTimings":[{"word":"Mina","charStart":0,"charEnd":4,"startMs":0,"endMs":360},{"word":"added","charStart":5,"charEnd":10,"startMs":360,"endMs":760},{"word":"Joining","charStart":13,"charEnd":20,"startMs":1120,"endMs":1420},{"word":"a","charStart":21,"charEnd":22,"startMs":1420,"endMs":1640},{"word":"club","charStart":23,"charEnd":27,"startMs":1640,"endMs":1880},{"word":"is","charStart":28,"charEnd":30,"startMs":1880,"endMs":2260},{"word":"also","charStart":31,"charEnd":35,"startMs":2260,"endMs":2620},{"word":"a","charStart":36,"charEnd":37,"startMs":2620,"endMs":2820},{"word":"great","charStart":38,"charEnd":43,"startMs":2820,"endMs":3080},{"word":"way","charStart":44,"charEnd":47,"startMs":3080,"endMs":3300},{"word":"to","charStart":48,"charEnd":50,"startMs":3300,"endMs":3520},{"word":"meet","charStart":51,"charEnd":55,"startMs":3520,"endMs":3620},{"word":"people","charStart":56,"charEnd":62,"startMs":3620,"endMs":3940}]}]},{"id":"daily-209-the-welcome-guide-p8","pageNo":8,"spread":"p8","imageUrl":"/seed/daily-209-the-welcome-guide/p8.webp","sentences":[{"id":"daily-209-the-welcome-guide-p8-s1","ord":0,"text":"Ms. Park walked over to check their work.","translation_ko":"박 선생님이 두 사람의 작업을 확인하러 다가오셨어요.","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p8-s1.mp3","wordTimings":[{"word":"Ms","charStart":0,"charEnd":2,"startMs":0,"endMs":420},{"word":"Park","charStart":4,"charEnd":8,"startMs":680,"endMs":800},{"word":"walked","charStart":9,"charEnd":15,"startMs":800,"endMs":1340},{"word":"over","charStart":16,"charEnd":20,"startMs":1340,"endMs":1640},{"word":"to","charStart":21,"charEnd":23,"startMs":1640,"endMs":1920},{"word":"check","charStart":24,"charEnd":29,"startMs":1920,"endMs":2080},{"word":"their","charStart":30,"charEnd":35,"startMs":2080,"endMs":2340},{"word":"work","charStart":36,"charEnd":40,"startMs":2340,"endMs":2600}]},{"id":"daily-209-the-welcome-guide-p8-s2","ord":1,"text":"\"This is wonderful,\" she said. \"But don't forget to explain the lunch system.\"","translation_ko":"\"정말 훌륭해요.\" 선생님이 말씀하셨어요. \"하지만 급식 시스템 설명도 잊지 말아요.\"","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p8-s2.mp3","wordTimings":[{"word":"This","charStart":1,"charEnd":5,"startMs":0,"endMs":320},{"word":"is","charStart":6,"charEnd":8,"startMs":320,"endMs":620},{"word":"wonderful","charStart":9,"charEnd":18,"startMs":620,"endMs":1040},{"word":"she","charStart":21,"charEnd":24,"startMs":1360,"endMs":1520},{"word":"said","charStart":25,"charEnd":29,"startMs":1520,"endMs":1780},{"word":"But","charStart":32,"charEnd":35,"startMs":2500,"endMs":2720},{"word":"don't","charStart":36,"charEnd":41,"startMs":2720,"endMs":2940},{"word":"forget","charStart":42,"charEnd":48,"startMs":2940,"endMs":3180},{"word":"to","charStart":49,"charEnd":51,"startMs":3180,"endMs":3500},{"word":"explain","charStart":52,"charEnd":59,"startMs":3500,"endMs":3720},{"word":"the","charStart":60,"charEnd":63,"startMs":3720,"endMs":3920},{"word":"lunch","charStart":64,"charEnd":69,"startMs":3920,"endMs":4140},{"word":"system","charStart":70,"charEnd":76,"startMs":4140,"endMs":4420}]},{"id":"daily-209-the-welcome-guide-p8-s3","ord":2,"text":"Jun laughed because he had been confused about it on his first day.","translation_ko":"준은 웃었어요. 자기도 첫날에 그것 때문에 당황했던 기억이 났거든요.","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p8-s3.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":460},{"word":"laughed","charStart":4,"charEnd":11,"startMs":460,"endMs":920},{"word":"because","charStart":12,"charEnd":19,"startMs":920,"endMs":1380},{"word":"he","charStart":20,"charEnd":22,"startMs":1380,"endMs":1520},{"word":"had","charStart":23,"charEnd":26,"startMs":1520,"endMs":1640},{"word":"been","charStart":27,"charEnd":31,"startMs":1640,"endMs":1820},{"word":"confused","charStart":32,"charEnd":40,"startMs":1820,"endMs":2260},{"word":"about","charStart":41,"c