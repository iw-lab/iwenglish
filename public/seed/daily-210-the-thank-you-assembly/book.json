you-assembly/audio/p13-s1.mp3","wordTimings":[{"word":"That","charStart":0,"charEnd":4,"startMs":0,"endMs":260},{"word":"night","charStart":5,"charEnd":10,"startMs":260,"endMs":660},{"word":"Jun","charStart":12,"charEnd":15,"startMs":980,"endMs":1120},{"word":"wrote","charStart":16,"charEnd":21,"startMs":1120,"endMs":1420},{"word":"in","charStart":22,"charEnd":24,"startMs":1420,"endMs":1660},{"word":"his","charStart":25,"charEnd":28,"startMs":1660,"endMs":1860},{"word":"journal","charStart":29,"charEnd":36,"startMs":1860,"endMs":2140},{"word":"Today","charStart":39,"charEnd":44,"startMs":2620,"endMs":2800},{"word":"I","charStart":45,"charEnd":46,"startMs":2800,"endMs":3020},{"word":"learned","charStart":47,"charEnd":54,"startMs":3020,"endMs":3240},{"word":"that","charStart":55,"charEnd":59,"startMs":3240,"endMs":3460},{"word":"gratitude","charStart":60,"charEnd":69,"startMs":3460,"endMs":3960},{"word":"can","charStart":70,"charEnd":73,"startMs":3960,"endMs":4420},{"word":"change","charStart":74,"charEnd":80,"startMs":4420,"endMs":4680},{"word":"how","charStart":81,"charEnd":84,"startMs":4680,"endMs":4880},{"word":"people","charStart":85,"charEnd":91,"startMs":4880,"endMs":5100},{"word":"feel","charStart":92,"charEnd":96,"startMs":5100,"endMs":5420},{"word":"about","charStart":97,"charEnd":102,"startMs":5420,"endMs":5640},{"word":"themselves","charStart":103,"charEnd":113,"startMs":5640,"endMs":6100}]},{"id":"daily-210-the-thank-you-assembly-p13-s2","ord":1,"text":"He decided to say thank you more often from now on.","translation_ko":"그는 앞으로 감사 인사를 더 자주 전하기로 다짐했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p13-s2.mp3","wordTimings":[{"word":"He","charStart":0,"charEnd":2,"startMs":0,"endMs":180},{"word":"decided","charStart":3,"charEnd":10,"startMs":180,"endMs":580},{"word":"to","charStart":11,"charEnd":13,"startMs":580,"endMs":920},{"word":"say","charStart":14,"charEnd":17,"startMs":920,"endMs":1200},{"word":"thank","charStart":18,"charEnd":23,"start