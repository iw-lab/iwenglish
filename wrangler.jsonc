{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echotale",
  "main": ".open-next/worker.js",
  // ⚠️ workerd 런타임 동작(스트리밍·nodejs_compat)은 이 날짜에 묶여 있다.
  // 2025-06-01 은 @opennextjs/cloudflare 1.19 기준 15개월 뒤처진 값이라
  // 빌드가 "더 최신 날짜로 올리라"고 경고한다(패키지 스캐폴더 기본값 = 2026-04-15).
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // D1: 현재 앱 코드에서 사용하지 않는 예약 바인딩이다.
  // 학습 기록은 전부 기기의 localStorage 에만 저장되며 서버로 전송되지 않는다.
  // 향후 "기기간 동기화"를 선택 기능으로 붙일 때 쓰려고 남겨 둔 자리(schema.sql 참고).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "echotale-db",
      "database_id": "3907cfb6-287c-48e2-a148-404ef69af408"
    }
  ]
}
