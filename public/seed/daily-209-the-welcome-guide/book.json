:2500},{"word":"they","charStart":32,"charEnd":36,"startMs":2500,"endMs":2720},{"word":"had","charStart":37,"charEnd":40,"startMs":2720,"endMs":2900},{"word":"created","charStart":41,"charEnd":48,"startMs":2900,"endMs":3300},{"word":"something","charStart":49,"charEnd":58,"startMs":3300,"endMs":3740},{"word":"truly","charStart":59,"charEnd":64,"startMs":3740,"endMs":4220},{"word":"helpful","charStart":65,"charEnd":72,"startMs":4220,"endMs":4560}]}]},{"id":"daily-209-the-welcome-guide-p13","pageNo":13,"spread":"p13","imageUrl":"/seed/daily-209-the-welcome-guide/p13.webp","sentences":[{"id":"daily-209-the-welcome-guide-p13-s1","ord":0,"text":"\"I hope the new students will feel welcome because of our guide,\" Mina said with a smile.","translation_ko":"\"우리 안내서 덕분에 신입생들이 환영받는 느낌이 들면 좋겠어.\" 미나가 미소 지으며 말했어요.","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p13-s1.mp3","wordTimings":[{"word":"I","charStart":1,"charEnd":2,"startMs":0,"endMs":200},{"word":"hope","charStart":3,"charEnd":7,"startMs":200,"endMs":440},{"word":"the","charStart":8,"charEnd":11,"startMs":440,"endMs":660},{"word":"new","charStart":12,"charEnd":15,"startMs":660,"endMs":880},{"word":"students","charStart":16,"charEnd":24,"startMs":880,"endMs":1240},{"word":"will","charStart":25,"charEnd":29,"startMs":1240,"endMs":1500},{"word":"feel","charStart":30,"charEnd":34,"startMs":1500,"endMs":1740},{"word":"welcome","charStart":35,"charEnd":42,"startMs":1740,"endMs":2140},{"word":"because","charStart":43,"charEnd":50,"startMs":2140,"endMs":2700},{"word":"of","charStart":51,"charEnd":53,"startMs":2700,"endMs":2860},{"word":"our","charStart":54,"charEnd":57,"startMs":2860,"endMs":3000},{"word":"guide","charStart":58,"charEnd":63,"startMs":3000,"endMs":3900},{"word":"Mina","charStart":66,"charEnd":70,"startMs":3900,"endMs":3940},{"word":"said","charStart":71,"charEnd":75,"startMs":3940,"endMs":4240},{"word":"with","charStart":76,"charEnd":80,"startMs":4240,"endMs":4520},{"word":"a","charStart":81,"charEnd":8