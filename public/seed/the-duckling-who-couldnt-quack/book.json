ldnt-quack-p8-s1","ord":0,"text":"\"QUACK!\" said Little Duck.","translation_ko":"\"꽥!\" 아기 오리가 말했어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p8-s1.mp3","wordTimings":[{"word":"QUACK","charStart":1,"charEnd":6,"startMs":0,"endMs":800},{"word":"said","charStart":9,"charEnd":13,"startMs":800,"endMs":1400},{"word":"Little","charStart":14,"charEnd":20,"startMs":1400,"endMs":1740},{"word":"Duck","charStart":21,"charEnd":25,"startMs":1740,"endMs":2160}]},{"id":"the-duckling-who-couldnt-quack-p8-s2","ord":1,"text":"A big, loud quack filled the air.","translation_ko":"크고 우렁찬 꽥 소리가 울려 퍼졌어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p8-s2.mp3","wordTimings":[{"word":"A","charStart":0,"charEnd":1,"startMs":0,"endMs":200},{"word":"big","charStart":2,"charEnd":5,"startMs":200,"endMs":620},{"word":"loud","charStart":7,"charEnd":11,"startMs":1180,"endMs":1380},{"word":"quack","charStart":12,"charEnd":17,"startMs":1380,"endMs":1820},{"word":"filled","charStart":18,"charEnd":24,"startMs":1820,"endMs":2320},{"word":"the","charStart":25,"charEnd":28,"startMs":2320,"endMs":2600},{"word":"air","charStart":29,"charEnd":32,"startMs":2600,"endMs":2680}]}]},{"id":"the-duckling-who-couldnt-quack-p9","pageNo":9,"spread":"p9","imageUrl":"/seed/the-duckling-who-couldnt-quack/p9.webp","sentences":[{"id":"the-duckling-who-couldnt-quack-p9-s1","ord":0,"text":"All her friends cheered and clapped their wings.","translation_ko":"친구들이 모두 날개를 치며 기뻐했어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p9-s1.mp3","wordTimings":[{"word":"All","charStart":0,"charEnd":3,"startMs":0,"endMs":760},{"word":"her","charStart":4,"charEnd":7,"startMs":760,"endMs":1020},{"word":"friends","charStart":8,"charEnd":15,"startMs":1020,"endMs":1360},{"word":"cheered","charStart":16,"charEnd":23,"startMs":1360,"endMs":1800},{"word":"and","charStart":24,"charEnd":27,"startMs":1800,"endMs":2140},{"word":"clapped","charStart":28,"charEnd":35,"startMs":2140,"endMs":2380},{"word":"their","cha