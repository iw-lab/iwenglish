.","audioUrl":"/seed/daily-166-the-mixed-up-shoes/audio/p3-s1.mp3","wordTimings":[{"word":"Mina","charStart":0,"charEnd":4,"startMs":0,"endMs":340},{"word":"came","charStart":5,"charEnd":9,"startMs":340,"endMs":740},{"word":"to","charStart":10,"charEnd":12,"startMs":740,"endMs":880},{"word":"the","charStart":13,"charEnd":16,"startMs":880,"endMs":1160},{"word":"door","charStart":17,"charEnd":21,"startMs":1160,"endMs":1220},{"word":"and","charStart":22,"charEnd":25,"startMs":1220,"endMs":1820},{"word":"looked","charStart":26,"charEnd":32,"startMs":1820,"endMs":2000},{"word":"down","charStart":33,"charEnd":37,"startMs":2000,"endMs":2240},{"word":"at","charStart":38,"charEnd":40,"startMs":2240,"endMs":2380},{"word":"her","charStart":41,"charEnd":44,"startMs":2380,"endMs":2520},{"word":"feet","charStart":45,"charEnd":49,"startMs":2520,"endMs":2760}]},{"id":"daily-166-the-mixed-up-shoes-p3-s2","ord":1,"text":"Her shoes were too small and hurt her toes.","translation_ko":"Mina의 신발은 너무 작아서 발가락이 아팠어요.","audioUrl":"/seed/daily-166-the-mixed-up-shoes/audio/p3-s2.mp3","wordTimings":[{"word":"Her","charStart":0,"charEnd":3,"startMs":0,"endMs":240},{"word":"shoes","charStart":4,"charEnd":9,"startMs":240,"endMs":580},{"word":"were","charStart":10,"charEnd":14,"startMs":580,"endMs":860},{"word":"too","charStart":15,"charEnd":18,"startMs":860,"endMs":1140},{"word":"small","charStart":19,"charEnd":24,"startMs":1140,"endMs":1380},{"word":"and","charStart":25,"charEnd":28,"startMs":1380,"endMs":1840},{"word":"hurt","charStart":29,"charEnd":33,"startMs":1840,"endMs":1940},{"word":"her","charStart":34,"charEnd":37,"startMs":1940,"endMs":2440},{"word":"toes","charStart":38,"charEnd":42,"startMs":2440,"endMs":2440}]}]},{"id":"daily-166-the-mixed-up-shoes-p4","pageNo":4,"spread":"p4","imageUrl":"/seed/daily-166-the-mixed-up-shoes/p4.webp","sentences":[{"id":"daily-166-the-mixed-up-shoes-p4-s1","ord":0,"text":"\"Jun, those are my shoes!\" said Mina.","translation_ko":"\"Jun, 그거 내 신발이야!\" Min