Ms":2340},{"word":"gave","charStart":26,"charEnd":30,"startMs":2340,"endMs":2600},{"word":"her","charStart":31,"charEnd":34,"startMs":2600,"endMs":2760},{"word":"the","charStart":35,"charEnd":38,"startMs":2760,"endMs":3000},{"word":"treat","charStart":39,"charEnd":44,"startMs":3000,"endMs":3240}]},{"id":"daily-188-training-our-puppy-p5-s2","ord":1,"text":"\"Good girl, Coco!\" Jun cheered loudly.","translation_ko":"\"잘했어, 코코!\" Jun이 크게 응원했어요.","audioUrl":"/seed/daily-188-training-our-puppy/audio/p5-s2.mp3","wordTimings":[{"word":"Good","charStart":1,"charEnd":5,"startMs":0,"endMs":400},{"word":"girl","charStart":6,"charEnd":10,"startMs":400,"endMs":880},{"word":"Coco","charStart":12,"charEnd":16,"startMs":1120,"endMs":1840},{"word":"Jun","charStart":19,"charEnd":22,"startMs":1840,"endMs":1900},{"word":"cheered","charStart":23,"charEnd":30,"startMs":1900,"endMs":2180},{"word":"loudly","charStart":31,"charEnd":37,"startMs":2180,"endMs":2500}]}]},{"id":"daily-188-training-our-puppy-p6","pageNo":6,"spread":"p6","imageUrl":"/seed/daily-188-training-our-puppy/p6.webp","sentences":[{"id":"daily-188-training-our-puppy-p6-s1","ord":0,"text":"Next, Jun tried the \"sit\" command himself.","translation_ko":"다음으로 Jun이 직접 '앉아' 명령을 해봤어요.","audioUrl":"/seed/daily-188-training-our-puppy/audio/p6-s1.mp3","wordTimings":[{"word":"Next","charStart":0,"charEnd":4,"startMs":0,"endMs":500},{"word":"Jun","charStart":6,"charEnd":9,"startMs":1260,"endMs":1460},{"word":"tried","charStart":10,"charEnd":15,"startMs":1460,"endMs":1740},{"word":"the","charStart":16,"charEnd":19,"startMs":1740,"endMs":2080},{"word":"sit","charStart":21,"charEnd":24,"startMs":2080,"endMs":2260},{"word":"command","charStart":26,"charEnd":33,"startMs":2260,"endMs":2620},{"word":"himself","charStart":34,"charEnd":41,"startMs":2620,"endMs":3160}]},{"id":"daily-188-training-our-puppy-p6-s2","ord":1,"text":"He held a treat high and said, \"Sit, Coco!\"","translation_ko":"Jun은 간식을 높이 들고 '앉아, 코코!'라고 말했어요.","audioUrl":"/seed/