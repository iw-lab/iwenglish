u-assembly-p8-s2","ord":1,"text":"The teachers and staff looked surprised and touched when they walked in.","translation_ko":"선생님들과 직원분들이 들어오자 놀라고 감동받은 표정을 지었어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p8-s2.mp3","wordTimings":[{"word":"The","charStart":0,"charEnd":3,"startMs":0,"endMs":260},{"word":"teachers","charStart":4,"charEnd":12,"startMs":260,"endMs":580},{"word":"and","charStart":13,"charEnd":16,"startMs":580,"endMs":920},{"word":"staff","charStart":17,"charEnd":22,"startMs":920,"endMs":1180},{"word":"looked","charStart":23,"charEnd":29,"startMs":1180,"endMs":1480},{"word":"surprised","charStart":30,"charEnd":39,"startMs":1480,"endMs":2020},{"word":"and","charStart":40,"charEnd":43,"startMs":2020,"endMs":2440},{"word":"touched","charStart":44,"charEnd":51,"startMs":2440,"endMs":2620},{"word":"when","charStart":52,"charEnd":56,"startMs":2620,"endMs":2980},{"word":"they","charStart":57,"charEnd":61,"startMs":2980,"endMs":3180},{"word":"walked","charStart":62,"charEnd":68,"startMs":3180,"endMs":3360},{"word":"in","charStart":69,"charEnd":71,"startMs":3360,"endMs":3600}]}]},{"id":"daily-210-the-thank-you-assembly-p9","pageNo":9,"spread":"p9","imageUrl":"/seed/daily-210-the-thank-you-assembly/p9.webp","sentences":[{"id":"daily-210-the-thank-you-assembly-p9-s1","ord":0,"text":"Jun walked up to the microphone and took a deep breath.","translation_ko":"Jun은 마이크 앞으로 걸어가 깊게 숨을 들이마셨어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p9-s1.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":460},{"word":"walked","charStart":4,"charEnd":10,"startMs":460,"endMs":780},{"word":"up","charStart":11,"charEnd":13,"startMs":780,"endMs":1040},{"word":"to","charStart":14,"charEnd":16,"startMs":1040,"endMs":1160},{"word":"the","charStart":17,"charEnd":20,"startMs":1160,"endMs":1400},{"word":"microphone","charStart":21,"charEnd":31,"startMs":1400,"endMs":1800},{"word":"and","charStart":32,"charEnd":35,"startMs":1800,"endMs":2180},{"word":"took","charStart":36,"charEnd":40,"startMs":2180,"endMs":2280},{"word":"a","charStart":41,"charEnd":42,"startMs":2280,"endMs":2580},{"word":"deep","charStart":43,"charEnd":47,"startMs":2580,"endMs":2780},{"word":"breath","charStart":48,"charEnd":54,"startMs":2780,"endMs":3060}]},{"id":"daily-210-the-thank-you-assembly-p9-s2","ord":1,"text":"He spoke clearly and thanked each person by name.","translation_ko":"그는 또렷하게 말하며 한 분 한 분 이름을 불러가며 감사 인사를 전했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p9-s2.mp3","wordTimings":[{"word":"He","charStart":0,"charEnd":2,"startMs":0,"endMs":260},{"word":"spoke","charStart":3,"charEnd":8,"startMs":260,"endMs":520},{"word":"clearly","charStart":9,"charEnd":16,"startMs":520,"endMs":980},{"word":"and","charStart":17,"charEnd":20,"startMs":980,"endMs":1360},{"word":"thanked","charStart":21,"charEnd":28,"startMs":1360,"endMs":1540},{"word":"each","charStart":29,"charEnd":33,"startMs":1540,"endMs":1940},{"word":"person","charStart":34,"charEnd":40,"startMs":1940,"endMs":2300},{"word":"by","charStart":41,"charEnd":43,"startMs":2300,"endMs":2560},{"word":"name","charStart":44,"charEnd":48,"startMs":2560,"endMs":2820}]},{"id":"daily-210-the-thank-you-assembly-p9-s3","ord":2,"text":"Everyone in the gym started clapping.","translation_ko":"체육관에 있던 모든 사람이 박수를 치기 시작했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p9-s3.mp3","wordTimings":[{"word":"Everyone","charStart":0,"charEnd":8,"startMs":0,"endMs":480},{"word":"in","charStart":9,"charEnd":11,"startMs":480,"endMs":780},{"word":"the","charStart":12,"charEnd":15,"startMs":780,"endMs":1000},{"word":"gym","charStart":16,"charEnd":19,"startMs":1000,"endMs":1220},{"word":"started","charStart":20,"charEnd":27,"startMs":1220,"endMs":1900},{"word":"clapping","charStart":28,"charEnd":36,"startMs":1900,"endMs":2200}]}]},{"id":"daily-210-the-thank-you-assembly-p10","pageNo":10,"spread":"p10","imageUrl":"/seed/daily-210-the-thank-you-assembly/p10.webp","sentences":[{"id":"daily-210-the-thank-you-assembly-p10-s1","ord":0,"text":"Ms. Park wiped a small tear from her eye.","translation_ko":"박 선생님은 눈가에 맺힌 눈물을 살짝 닦으셨어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p10-s1.mp3","wordTimings":[{"word":"Ms","charStart":0,"charEnd":2,"startMs":0,"endMs":500},{"word":"Park","charStart":4,"charEnd":8,"startMs":1080,"endMs":1280},{"word":"wiped","charStart":9,"charEnd":14,"startMs":1280,"endMs":1820},{"word":"a","charStart":15,"charEnd":16,"startMs":1820,"endMs":2100},{"word":"small","charStart":17,"charEnd":22,"startMs":2100,"endMs":2400},{"word":"tear","charStart":23,"charEnd":27,"startMs":2400,"endMs":2740},{"word":"from","charStart":28,"charEnd":32,"startMs":2740,"endMs":3160},{"word":"her","charStart":33,"charEnd":36,"startMs":3160,"endMs":3340},{"word":"eye","charStart":37,"charEnd":40,"startMs":3340,"endMs":3600}]},{"id":"daily-210-the-thank-you-assembly-p10-s2","ord":1,"text":"\"I had no idea how much the students noticed our work,\" she said softly.","translation_ko":"\"학생들이 우리의 노력을 이렇게 많이 알아주는 줄 몰랐어요,\" 선생님이 조용히 말씀하셨어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p10-s2.mp3","wordTimings":[{"word":"I","charStart":1,"charEnd":2,"startMs":0,"endMs":300},{"word":"had","charStart":3,"charEnd":6,"startMs":300,"endMs":660},{"word":"no","charStart":7,"charEnd":9,"startMs":660,"endMs":1280},{"word":"idea","charStart":10,"charEnd":14,"startMs":1280,"endMs":1820},{"word":"how","charStart":15,"charEnd":18,"startMs":1820,"endMs":2140},{"word":"much","charStart":19,"charEnd":23,"startMs":2140,"endMs":2340},{"word":"the","charStart":24,"charEnd":27,"startMs":2340,"endMs":2660},{"word":"students","charStart":28,"charEnd":36,"startMs":2660,"endMs":2940},{"word":"noticed","charStart":37,"charEnd":44,"startMs":2940,"endMs":3360},{"word":"our","charStart":45,"charEnd":48,"startMs":3360,"endMs":3680},{"word":"work","charStart":49,"charEnd":53,"startMs":3680,"endMs":4300},{"word":"she","charStart":56,"charEnd":59,"startMs":4300,"endMs":4420},{"word":"said","charStart":60,"charEnd":64,"startMs":4420,"endMs":4660},{"word":"softly","charStart":65,"charEnd":71,"startMs":4660,"endMs":5060}]}]},{"id":"daily-210-the-thank-you-assembly-p11","pageNo":11,"spread":"p11","imageUrl":"/seed/daily-210-the-thank-you-assembly/p11.webp","sentences":[{"id":"daily-210-the-thank-you-assembly-p11-s1","ord":0,"text":"After the assembly, the janitor shook Jun's hand.","translation_ko":"발표회가 끝난 후, 청소부 아저씨가 Jun의 손을 꼭 잡으셨어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p11-s1.mp3","wordTimings":[{"word":"After","charStart":0,"charEnd":5,"startMs":0,"endMs":320},{"word":"the","charStart":6,"charEnd":9,"startMs":320,"endMs":580},{"word":"assembly","charStart":10,"charEnd":18,"startMs":580,"endMs":920},{"word":"the","charStart":20,"charEnd":23,"startMs":1300,"endMs":1440},{"word":"janitor","charStart":24,"charEnd":31,"startMs":1440,"endMs":1740},{"word":"shook","charStart":32,"charEnd":37,"startMs":1740,"endMs":2060},{"word":"Jun's","charStart":38,"charEnd":43,"startMs":2060,"endMs":2500},{"word":"hand","charStart":44,"charEnd":48,"startMs":2500,"endMs":2740}]},{"id":"daily-210-the-thank-you-assembly-p11-s2","ord":1,"text":"\"Because of your kind words, I feel proud of my work,\" the janitor said with a bright smile.","translation_ko":"\"네 따뜻한 말 덕분에 내 일이 자랑스럽게 느껴져,\" 아저씨가 환하게 웃으며 말씀하셨어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p11-s2.mp3","wordTimings":[{"word":"Because","charStart":1,"charEnd":8,"startMs":0,"endMs":400},{"word":"of","charStart":9,"charEnd":11,"startMs":400,"endMs":560},{"word":"your","charStart":12,"charEnd":16,"startMs":560,"endMs":760},{"word":"kind","charStart":17,"charEnd":21,"startMs":760,"endMs":1180},{"word":"words","charStart":22,"charEnd":27,"startMs":1180,"endMs":1540},{"word":"I","charStart":29,"charEnd":30,"startMs":1900,"endMs":2140},{"word":"feel","charStart":31,"charEnd":35,"startMs":2140,"endMs":2360},{"word":"proud","charStart":36,"charEnd":41,"startMs":2360,"endMs":2700},{"word":"of","charStart":42,"charEnd":44,"startMs":2700,"endMs":2860},{"word":"my","charStart":45,"charEnd":47,"startMs":2860,"endMs":3120},{"word":"work","charStart":48,"charEnd":52,"startMs":3120,"endMs":3760},{"word":"the","charStart":55,"charEnd":58,"startMs":3760,"endMs":3860},{"word":"janitor","charStart":59,"charEnd":66,"startMs":3860,"endMs":4200},{"word":"said","charStart":67,"charEnd":71,"startMs":4200,"endMs":4480},{"word":"with","charStart":72,"charEnd":76,"startMs":4480,"endMs":4640},{"word":"a","charStart":77,"charEnd":78,"startMs":4640,"endMs":5020},{"word":"bright","charStart":79,"charEnd":85,"startMs":5020,"endMs":5100},{"word":"smile","charStart":86,"charEnd":91,"startMs":5100,"endMs":5520}]}]},{"id":"daily-210-the-thank-you-assembly-p12","pageNo":12,"spread":"p12","imageUrl":"/seed/daily-210-the-thank-you-assembly/p12.webp","sentences":[{"id":"daily-210-the-thank-you-assembly-p12-s1","ord":0,"text":"On the way home, Mina said, \"I'm glad we did this. It made everyone happy.\"","translation_ko":"집에 가는 길에 미나가 말했어요. \"우리가 이걸 해서 정말 다행이야. 모두를 행복하게 해 줬잖아.\"","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p12-s1.mp3","wordTimings":[{"word":"On","charStart":0,"charEnd":2,"startMs":0,"endMs":720},{"word":"the","charStart":3,"charEnd":6,"startMs":720,"endMs":860},{"word":"way","charStart":7,"charEnd":10,"startMs":860,"endMs":1100},{"word":"home","charStart":11,"charEnd":15,"startMs":1100,"endMs":1480},{"word":"Mina","charStart":17,"charEnd":21,"startMs":2020,"endMs":2080},{"word":"said","charStart":22,"charEnd":26,"startMs":2080,"endMs":2440},{"word":"I'm","charStart":29,"charEnd":32,"startMs":2860,"endMs":3000},{"word":"glad","charStart":33,"charEnd":37,"startMs":3000,"endMs":3220},{"word":"we","charStart":38,"charEnd":40,"startMs":3220,"endMs":3420},{"word":"did","charStart":41,"charEnd":44,"startMs":3420,"endMs":3560},{"word":"this","charStart":45,"charEnd":49,"startMs":3560,"endMs":3880},{"word":"It","charStart":51,"