},{"word":"new","charStart":34,"charEnd":37,"startMs":1740,"endMs":2020},{"word":"frame","charStart":38,"charEnd":43,"startMs":2020,"endMs":2220},{"word":"went","charStart":44,"charEnd":48,"startMs":2220,"endMs":2460},{"word":"up","charStart":49,"charEnd":51,"startMs":2460,"endMs":2760}]}]},{"id":"daily-198-the-playground-plan-p12","pageNo":12,"spread":"p12","imageUrl":"/seed/daily-198-the-playground-plan/p12.webp","sentences":[{"id":"daily-198-the-playground-plan-p12-s1","ord":0,"text":"After school, everyone ran to try the climbing frame.","translation_ko":"방과 후, 모두가 정글짐을 타러 달려갔다.","audioUrl":"/seed/daily-198-the-playground-plan/audio/p12-s1.mp3","wordTimings":[{"word":"After","charStart":0,"charEnd":5,"startMs":0,"endMs":340},{"word":"school","charStart":6,"charEnd":12,"startMs":340,"endMs":700},{"word":"everyone","charStart":14,"charEnd":22,"startMs":1020,"endMs":1340},{"word":"ran","charStart":23,"charEnd":26,"startMs":1340,"endMs":1560},{"word":"to","charStart":27,"charEnd":29,"startMs":1560,"endMs":1740},{"word":"try","charStart":30,"charEnd":33,"startMs":1740,"endMs":1900},{"word":"the","charStart":34,"charEnd":37,"startMs":1900,"endMs":2140},{"word":"climbing","charStart":38,"charEnd":46,"startMs":2140,"endMs":2360},{"word":"frame","charStart":47,"charEnd":52,"startMs":2360,"endMs":2720}]},{"id":"daily-198-the-playground-plan-p12-s2","ord":1,"text":"Mina climbed to the top and waved her notebook.","translation_ko":"미나는 꼭대기에 올라가 공책을 흔들었다.","audioUrl":"/seed/daily-198-the-playground-plan/audio/p12-s2.mp3","wordTimings":[{"word":"Mina","charStart":0,"charEnd":4,"startMs":0,"endMs":420},{"word":"climbed","charStart":5,"charEnd":12,"startMs":420,"endMs":880},{"word":"to","charStart":13,"charEnd":15,"startMs":880,"endMs":1100},{"word":"the","charStart":16,"charEnd":19,"startMs":1100,"endMs":1260},{"word":"top","charStart":20,"charEnd":23,"startMs":1260,"endMs":1540},{"word":"and","charStart":24,"charEnd":27,"startMs":1540,"endMs":1980},{"word":"waved","charStart":28,"charEnd":33,"startMs":1980,"endMs":2180},{"word":"her","charStart":34,"charEnd":37,"startMs":2180,"endMs":2460},{"word":"notebook","charStart":38,"charEnd":46,"startMs":2460,"endMs":2740}]},{"id":"daily-198-the-playground-plan-p12-s3","ord":2,"text":"\"We planned this together,\" she called to Jun.","translation_ko":"\"우리가 함께 계획한 거야,\" 미나가 준에게 외쳤다.","audioUrl":"/seed/daily-198-the-playground-plan/audio/p12-s3.mp3","wordTimings":[{"word":"We","charStart":1,"charEnd":3,"startMs":0,"endMs":380},{"word":"planned","charStart":4,"charEnd":11,"startMs":380,"endMs":860},{"word":"this","charStart":12,"charEnd":16,"startMs":860,"endMs":1240},{"word":"together","charStart":17,"charEnd":25,"startMs":1240,"endMs":1560},{"word":"she","charStart":28,"charEnd":31,"startMs":1960,"endMs":2120},{"word":"called","charStart":32,"charEnd":38,"startMs":2120,"endMs":2340},{"word":"to","charStart":39,"charEnd":41,"startMs":2340,"endMs":2660},{"word":"Jun","charStart":42,"charEnd":45,"startMs":2660,"endMs":2780}]}]},{"id":"daily-198-the-playground-plan-p13","pageNo":13,"spread":"p13","imageUrl":"/seed/daily-198-the-playground-plan/p13.webp","sentences":[{"id":"daily-198-the-playground-plan-p13-s1","ord":0,"text":"Jun laughed and climbed up after her.","translation_ko":"준은 웃으며 미나를 따라 올라갔다.","audioUrl":"/seed/daily-198-the-playground-plan/audio/p13-s1.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":480},{"word":"laughed","charStart":4,"charEnd":11,"startMs":480,"endMs":860},{"word":"and","charStart":12,"charEnd":15,"startMs":860,"endMs":1180},{"word":"climbed","charStart":16,"charEnd":23,"startMs":1180,"endMs":1460},{"word":"up","charStart":24,"charEnd":26,"startMs":1460,"endMs":1720},{"word":"after","charStart":27,"charEnd":32,"startMs":1720,"endMs":2060},{"word":"her","charStart":33,"charEnd":36,"startMs":2060,"endMs":2220}]},{"id":"daily-198-the-playground-plan-p13-s2","ord":1,"text":"\"Next time, let's plan a school garden,\" he said.","translation_ko":