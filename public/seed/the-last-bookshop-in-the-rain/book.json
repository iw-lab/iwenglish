he-last-bookshop-in-the-rain/p3.webp","sentences":[{"id":"the-last-bookshop-in-the-rain-p3-s1","ord":0,"text":"Mia opened the door and heard a soft bell ring.","translation_ko":"미아가 문을 열자 작은 종소리가 부드럽게 울렸습니다.","audioUrl":"/seed/the-last-bookshop-in-the-rain/audio/p3-s1.mp3","wordTimings":[{"word":"Mia","charStart":0,"charEnd":3,"startMs":0,"endMs":420},{"word":"opened","charStart":4,"charEnd":10,"startMs":420,"endMs":880},{"word":"the","charStart":11,"charEnd":14,"startMs":880,"endMs":1040},{"word":"door","charStart":15,"charEnd":19,"startMs":1040,"endMs":1340},{"word":"and","charStart":20,"charEnd":23,"startMs":1340,"endMs":1900},{"word":"heard","charStart":24,"charEnd":29,"startMs":1900,"endMs":2160},{"word":"a","charStart":30,"charEnd":31,"startMs":2160,"endMs":2340},{"word":"soft","charStart":32,"charEnd":36,"startMs":2340,"endMs":2680},{"word":"bell","charStart":37,"charEnd":41,"startMs":2680,"endMs":2980},{"word":"ring","charStart":42,"charEnd":46,"startMs":2980,"endMs":3340}]},{"id":"the-last-bookshop-in-the-rain-p3-s2","ord":1,"text":"\"Welcome,\" said Mr. Ellis quietly, without looking up.","translation_ko":"\"어서 오세요,\" 엘리스 씨는 고개도 들지 않고 조용히 말했습니다.","audioUrl":"/seed/the-last-bookshop-in-the-rain/audio/p3-s2.mp3","wordTimings":[{"word":"Welcome","charStart":1,"charEnd":8,"startMs":0,"endMs":820},{"word":"said","charStart":11,"charEnd":15,"startMs":820,"endMs":1160},{"word":"Mr","charStart":16,"charEnd":18,"startMs":1160,"endMs":1500},{"word":"Ellis","charStart":20,"charEnd":25,"startMs":1760,"endMs":1800},{"word":"quietly","charStart":26,"charEnd":33,"startMs":1800,"endMs":2320},{"word":"without","charStart":35,"charEnd":42,"startMs":2880,"endMs":3160},{"word":"looking","charStart":43,"charEnd":50,"startMs":3160,"endMs":3440},{"word":"up","charStart":51,"charEnd":53,"startMs":3440,"endMs":3760}]},{"id":"the-last-bookshop-in-the-rain-p3-s3","ord":2,"text":"He was reading a worn book by the window.","translation_ko":"그는 창가에서 낡은 책을 읽고 있었습니다.","audioUrl":"/seed/t