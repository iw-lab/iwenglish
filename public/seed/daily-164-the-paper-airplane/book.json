io/p2-s1.mp3","wordTimings":[{"word":"Dad","charStart":0,"charEnd":3,"startMs":0,"endMs":460},{"word":"sat","charStart":4,"charEnd":7,"startMs":460,"endMs":740},{"word":"next","charStart":8,"charEnd":12,"startMs":740,"endMs":1080},{"word":"to","charStart":13,"charEnd":15,"startMs":1080,"endMs":1360},{"word":"Jun","charStart":16,"charEnd":19,"startMs":1360,"endMs":1540}]},{"id":"daily-164-the-paper-airplane-p2-s2","ord":1,"text":"\"I can help you,\" said Dad.","translation_ko":"\"내가 도와줄게,\" 아빠가 말했어요.","audioUrl":"/seed/daily-164-the-paper-airplane/audio/p2-s2.mp3","wordTimings":[{"word":"I","charStart":1,"charEnd":2,"startMs":0,"endMs":140},{"word":"can","charStart":3,"charEnd":6,"startMs":140,"endMs":340},{"word":"help","charStart":7,"charEnd":11,"startMs":340,"endMs":580},{"word":"you","charStart":12,"charEnd":15,"startMs":580,"endMs":1260},{"word":"said","charStart":18,"charEnd":22,"startMs":1260,"endMs":1340},{"word":"Dad","charStart":23,"charEnd":26,"startMs":1340,"endMs":1640}]}]},{"id":"daily-164-the-paper-airplane-p3","pageNo":3,"spread":"p3","imageUrl":"/seed/daily-164-the-paper-airplane/p3.webp","sentences":[{"id":"daily-164-the-paper-airplane-p3-s1","ord":0,"text":"Dad folded the paper in half.","translation_ko":"아빠가 종이를 반으로 접었어요.","audioUrl":"/seed/daily-164-the-paper-airplane/audio/p3-s1.mp3","wordTimings":[{"word":"Dad","charStart":0,"charEnd":3,"startMs":0,"endMs":520},{"word":"folded","charStart":4,"charEnd":10,"startMs":520,"endMs":920},{"word":"the","charStart":11,"charEnd":14,"startMs":920,"endMs":1200},{"word":"paper","charStart":15,"charEnd":20,"startMs":1200,"endMs":1420},{"word":"in","charStart":21,"charEnd":23,"startMs":1420,"endMs":1720},{"word":"half","charStart":24,"charEnd":28,"startMs":1720,"endMs":1980}]},{"id":"daily-164-the-paper-airplane-p3-s2","ord":1,"text":"Then he folded the corners down.","translation_ko":"그런 다음 모서리를 아래로 접었어요.","audioUrl":"/seed/daily-164-the-paper-airplane/audio/p3-s2.mp3","wordTimings":[{"word":"Then","charStar