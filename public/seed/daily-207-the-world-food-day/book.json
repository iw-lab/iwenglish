,"charEnd":26,"startMs":1940,"endMs":2280},{"word":"lit","charStart":27,"charEnd":30,"startMs":2280,"endMs":2520},{"word":"up","charStart":31,"charEnd":33,"startMs":2520,"endMs":2800},{"word":"Delicious","charStart":36,"charEnd":45,"startMs":3520,"endMs":3560}]}]},{"id":"daily-207-the-world-food-day-p7","pageNo":7,"spread":"p7","imageUrl":"/seed/daily-207-the-world-food-day/p7.webp","sentences":[{"id":"daily-207-the-world-food-day-p7-s1","ord":0,"text":"Next, they tried pasta from Italy.","translation_ko":"다음으로 이탈리아 파스타를 먹어봤어요.","audioUrl":"/seed/daily-207-the-world-food-day/audio/p7-s1.mp3","wordTimings":[{"word":"Next","charStart":0,"charEnd":4,"startMs":0,"endMs":420},{"word":"they","charStart":6,"charEnd":10,"startMs":920,"endMs":1100},{"word":"tried","charStart":11,"charEnd":16,"startMs":1100,"endMs":1360},{"word":"pasta","charStart":17,"charEnd":22,"startMs":1360,"endMs":1800},{"word":"from","charStart":23,"charEnd":27,"startMs":1800,"endMs":2260},{"word":"Italy","charStart":28,"charEnd":33,"startMs":2260,"endMs":2500}]},{"id":"daily-207-the-world-food-day-p7-s2","ord":1,"text":"\"The sauce is made with tomatoes and garlic,\" said Ms. Park.","translation_ko":"\"소스는 토마토와 마늘로 만들어요.\"라고 박 선생님이 말씀하셨어요.","audioUrl":"/seed/daily-207-the-world-food-day/audio/p7-s2.mp3","wordTimings":[{"word":"The","charStart":1,"charEnd":4,"startMs":0,"endMs":700},{"word":"sauce","charStart":5,"charEnd":10,"startMs":700,"endMs":1040},{"word":"is","charStart":11,"charEnd":13,"startMs":1040,"endMs":1340},{"word":"made","charStart":14,"charEnd":18,"startMs":1340,"endMs":1440},{"word":"with","charStart":19,"charEnd":23,"startMs":1440,"endMs":2120},{"word":"tomatoes","charStart":24,"charEnd":32,"startMs":2120,"endMs":2120},{"word":"and","charStart":33,"charEnd":36,"startMs":2120,"endMs":2840},{"word":"garlic","charStart":37,"charEnd":43,"startMs":2840,"endMs":3680},{"word":"said","charStart":46,"charEnd":50,"startMs":3680,"endMs":3680},{"word":"Ms","charStart":51,"charEnd":53,"startMs":36