":2980},{"word":"not","charStart":42,"charEnd":45,"startMs":2980,"endMs":3260},{"word":"fall","charStart":46,"charEnd":50,"startMs":3260,"endMs":3500},{"word":"out","charStart":51,"charEnd":54,"startMs":3500,"endMs":3760}]}]},{"id":"daily-161-the-wobbly-tooth-p6","pageNo":6,"spread":"p6","imageUrl":"/seed/daily-161-the-wobbly-tooth/p6.webp","sentences":[{"id":"daily-161-the-wobbly-tooth-p6-s1","ord":0,"text":"After dinner, Mom tied a small string to the tooth.","translation_ko":"저녁 식사 후, 엄마는 이에 작은 실을 묶었어요.","audioUrl":"/seed/daily-161-the-wobbly-tooth/audio/p6-s1.mp3","wordTimings":[{"word":"After","charStart":0,"charEnd":5,"startMs":0,"endMs":320},{"word":"dinner","charStart":6,"charEnd":12,"startMs":320,"endMs":620},{"word":"Mom","charStart":14,"charEnd":17,"startMs":1080,"endMs":1140},{"word":"tied","charStart":18,"charEnd":22,"startMs":1140,"endMs":1400},{"word":"a","charStart":23,"charEnd":24,"startMs":1400,"endMs":1620},{"word":"small","charStart":25,"charEnd":30,"startMs":1620,"endMs":1920},{"word":"string","charStart":31,"charEnd":37,"startMs":1920,"endMs":2140},{"word":"to","charStart":38,"charEnd":40,"startMs":2140,"endMs":2320},{"word":"the","charStart":41,"charEnd":44,"startMs":2320,"endMs":2720},{"word":"tooth","charStart":45,"charEnd":50,"startMs":2720,"endMs":2740}]},{"id":"daily-161-the-wobbly-tooth-p6-s2","ord":1,"text":"\"Close your eyes,\" she said.","translation_ko":"\"눈을 감아,\" 엄마가 말했어요.","audioUrl":"/seed/daily-161-the-wobbly-tooth/audio/p6-s2.mp3","wordTimings":[{"word":"Close","charStart":1,"charEnd":6,"startMs":0,"endMs":360},{"word":"your","charStart":7,"charEnd":11,"startMs":360,"endMs":560},{"word":"eyes","charStart":12,"charEnd":16,"startMs":560,"endMs":1140},{"word":"she","charStart":19,"charEnd":22,"startMs":1140,"endMs":1260},{"word":"said","charStart":23,"charEnd":27,"startMs":1260,"endMs":1520}]}]},{"id":"daily-161-the-wobbly-tooth-p7","pageNo":7,"spread":"p7","imageUrl":"/seed/daily-161-the-wobbly-tooth/p7.webp","sentences":[{"id":"daily-161-the-wobbly-tooth-p7-s1","ord":0,"text":"Mom pulled the string, and the tooth came out!","translation_ko":"엄마가 실을 잡아당기자, 이가 쏙 빠졌어요!","audioUrl":"/seed/daily-161-the-wobbly-tooth/audio/p7-s1.mp3","wordTimings":[{"word":"Mom","charStart":0,"charEnd":3,"startMs":0,"endMs":460},{"word":"pulled","charStart":4,"charEnd":10,"startMs":460,"endMs":940},{"word":"the","charStart":11,"charEnd":14,"startMs":940,"endMs":1220},{"word":"string","charStart":15,"charEnd":21,"startMs":1220,"endMs":1500},{"word":"and","charStart":23,"charEnd":26,"startMs":1940,"endMs":2060},{"word":"the","charStart":27,"charEnd":30,"startMs":2060,"endMs":2240},{"word":"tooth","charStart":31,"charEnd":36,"startMs":2240,"endMs":2420},{"word":"came","charStart":37,"charEnd":41,"startMs":2420,"endMs":2720},{"word":"out","charStart":42,"charEnd":45,"startMs":2720,"endMs":3000}]},{"id":"daily-161-the-wobbly-tooth-p7-s2","ord":1,"text":"Jun felt a small gap and smiled.","translation_ko":"Jun은 작은 빈 자리를 혀로 느끼며 씩 웃었어요.","audioUrl":"/seed/daily-161-the-wobbly-tooth/audio/p7-s2.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":440},{"word":"felt","charStart":4,"charEnd":8,"startMs":440,"endMs":780},{"word":"a","charStart":9,"charEnd":10,"startMs":780,"endMs":1100},{"word":"small","charStart":11,"charEnd":16,"startMs":1100,"endMs":1400},{"word":"gap","charStart":17,"charEnd":20,"startMs":1400,"endMs":1660},{"word":"and","charStart":21,"charEnd":24,"startMs":1660,"endMs":2200},{"word":"smiled","charStart":25,"charEnd":31,"startMs":2200,"endMs":2560}]}]},{"id":"daily-161-the-wobbly-tooth-p8","pageNo":8,"spread":"p8","imageUrl":"/seed/daily-161-the-wobbly-tooth/p8.webp","sentences":[{"id":"daily-161-the-wobbly-tooth-p8-s1","ord":0,"text":"\"I lost my tooth!\" Jun shouted.","translation_ko":"\"이가 빠졌어!\" Jun이 크게 외쳤어요.","audioUrl":"/seed/daily-161-the-wobbly-tooth/audio/p8-s1.mp3","wordTimings":[{"word":"I","charStart":1,"charEnd":2,"startMs":0,"endMs":380},{"word":"lost","charStart