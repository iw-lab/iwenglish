tart":0,"charEnd":1,"startMs":0,"endMs":580},{"word":"snowflake","charStart":2,"charEnd":11,"startMs":580,"endMs":1100},{"word":"landed","charStart":12,"charEnd":18,"startMs":1100,"endMs":1440},{"word":"on","charStart":19,"charEnd":21,"startMs":1440,"endMs":1780},{"word":"his","charStart":22,"charEnd":25,"startMs":1780,"endMs":2000},{"word":"palm","charStart":26,"charEnd":30,"startMs":2000,"endMs":2320}]}]},{"id":"daily-169-the-first-snowflake-p4","pageNo":4,"spread":"p4","imageUrl":"/seed/daily-169-the-first-snowflake/p4.webp","sentences":[{"id":"daily-169-the-first-snowflake-p4-s1","ord":0,"text":"It was small and white.","translation_ko":"눈송이는 작고 하얬어요.","audioUrl":"/seed/daily-169-the-first-snowflake/audio/p4-s1.mp3","wordTimings":[{"word":"It","charStart":0,"charEnd":2,"startMs":0,"endMs":140},{"word":"was","charStart":3,"charEnd":6,"startMs":140,"endMs":440},{"word":"small","charStart":7,"charEnd":12,"startMs":440,"endMs":820},{"word":"and","charStart":13,"charEnd":16,"startMs":820,"endMs":1440},{"word":"white","charStart":17,"charEnd":22,"startMs":1440,"endMs":1700}]},{"id":"daily-169-the-first-snowflake-p4-s2","ord":1,"text":"But it melted fast.","translation_ko":"하지만 금방 녹아 버렸어요.","audioUrl":"/seed/daily-169-the-first-snowflake/audio/p4-s2.mp3","wordTimings":[{"word":"But","charStart":0,"charEnd":3,"startMs":0,"endMs":420},{"word":"it","charStart":4,"charEnd":6,"startMs":420,"endMs":780},{"word":"melted","charStart":7,"charEnd":13,"startMs":780,"endMs":1080},{"word":"fast","charStart":14,"charEnd":18,"startMs":1080,"endMs":1680}]}]},{"id":"daily-169-the-first-snowflake-p5","pageNo":5,"spread":"p5","imageUrl":"/seed/daily-169-the-first-snowflake/p5.webp","sentences":[{"id":"daily-169-the-first-snowflake-p5-s1","ord":0,"text":"Jun caught more snowflakes.","translation_ko":"Jun은 눈송이를 더 받아 보았어요.","audioUrl":"/seed/daily-169-the-first-snowflake/audio/p5-s1.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":420},{"word":"caught","charSt