/p13-s3.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":660},{"word":"copied","charStart":4,"charEnd":10,"startMs":660,"endMs":1160},{"word":"it","charStart":11,"charEnd":13,"startMs":1160,"endMs":1340},{"word":"into","charStart":14,"charEnd":18,"startMs":1340,"endMs":1620},{"word":"his","charStart":19,"charEnd":22,"startMs":1620,"endMs":1900},{"word":"notebook","charStart":23,"charEnd":31,"startMs":1900,"endMs":2240},{"word":"and","charStart":32,"charEnd":35,"startMs":2240,"endMs":2820},{"word":"promised","charStart":36,"charEnd":44,"startMs":2820,"endMs":3180},{"word":"himself","charStart":45,"charEnd":52,"startMs":3180,"endMs":3600},{"word":"he","charStart":53,"charEnd":55,"startMs":3600,"endMs":3820},{"word":"would","charStart":56,"charEnd":61,"startMs":3820,"endMs":3940},{"word":"never","charStart":62,"charEnd":67,"startMs":3940,"endMs":4340},{"word":"forget","charStart":68,"charEnd":74,"startMs":4340,"endMs":4660},{"word":"it","charStart":75,"charEnd":77,"startMs":4660,"endMs":4880}]}]}],"quiz":[{"question_ko":"담요 나눔 행사는 누구를 위한 것인가요?","type":"mc","options":["어린 아이들","어르신들","학교 선생님들","동네 가게 주인들"],"answerIndex":1,"explain_ko":"Park 선생님이 어르신들을 위해 따뜻한 담요를 모은다고 설명하셨어요.","id":"daily-197-the-blanket-drive-q1","ord":0},{"question_ko":"Jun의 엄마가 옷장에서 찾은 담요는 몇 장인가요?","type":"mc","options":["한 장","세 장","두 장","네 장"],"answerIndex":2,"explain_ko":"Jun의 엄마는 옷장에서 두꺼운 담요 두 장을 찾아냈어요.","id":"daily-197-the-blanket-drive-q2","ord":1},{"question_ko":"반 전체가 모은 담요는 모두 몇 장인가요?","type":"mc","options":["열다섯 장","스물두 장","열두 장","서른 장"],"answerIndex":1,"explain_ko":"Park 선생님이 금요일 아침에 세어 보니 총 스물두 장이 모였어요.","id":"daily-197-the-blanket-drive-q3","ord":2},{"question_ko":"마을 회관에서 아이들을 맞이한 사람은 누구인가요?","type":"mc","options":["Jun의 엄마","Mina의 할머니","최 할머니","마을 이장님"],"answerIndex":2,"explain_ko":"최 할머니(Mrs. Choi)가 마을 회관 입구에서 따뜻하게 맞이해 주셨어요.","id":"daily-197-the-blanket-drive-q4","ord":3},{"question_ko":"Park 선생님이 교실 칠판에 쓴 메시지는 무엇인가요?","type":"mc","options":["함께 공부하면 더 많이