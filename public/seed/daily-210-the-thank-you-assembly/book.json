sembly-p4-s1","ord":0,"text":"Jun and Mina made a list of every person they wanted to thank.","translation_ko":"Jun과 미나는 감사 인사를 전하고 싶은 사람들의 목록을 만들었어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p4-s1.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":480},{"word":"and","charStart":4,"charEnd":7,"startMs":480,"endMs":800},{"word":"Mina","charStart":8,"charEnd":12,"startMs":800,"endMs":1120},{"word":"made","charStart":13,"charEnd":17,"startMs":1120,"endMs":1540},{"word":"a","charStart":18,"charEnd":19,"startMs":1540,"endMs":1720},{"word":"list","charStart":20,"charEnd":24,"startMs":1720,"endMs":1940},{"word":"of","charStart":25,"charEnd":27,"startMs":1940,"endMs":2300},{"word":"every","charStart":28,"charEnd":33,"startMs":2300,"endMs":2540},{"word":"person","charStart":34,"charEnd":40,"startMs":2540,"endMs":2860},{"word":"they","charStart":41,"charEnd":45,"startMs":2860,"endMs":3100},{"word":"wanted","charStart":46,"charEnd":52,"startMs":3100,"endMs":3320},{"word":"to","charStart":53,"charEnd":55,"startMs":3320,"endMs":3560},{"word":"thank","charStart":56,"charEnd":61,"startMs":3560,"endMs":3760}]},{"id":"daily-210-the-thank-you-assembly-p4-s2","ord":1,"text":"They included the principal, the cook, the janitor, and the librarian.","translation_ko":"교장 선생님, 조리사, 청소부 아저씨, 사서 선생님도 포함했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p4-s2.mp3","wordTimings":[{"word":"They","charStart":0,"charEnd":4,"startMs":0,"endMs":380},{"word":"included","charStart":5,"charEnd":13,"startMs":380,"endMs":700},{"word":"the","charStart":14,"charEnd":17,"startMs":700,"endMs":1160},{"word":"principal","charStart":18,"charEnd":27,"startMs":1160,"endMs":1520},{"word":"the","charStart":29,"charEnd":32,"startMs":2000,"endMs":2360},{"word":"cook","charStart":33,"charEnd":37,"startMs":2360,"endMs":2360},{"word":"the","charStart":39,"charEnd":42,"startMs":2760,"endMs":3100},{"word":"janitor","charStart":43,"charEnd":50,"startMs":3100,"endMs":3260},{"word":"and","charStart":52,"charEnd":55,"startMs":3620,"endMs":3780},{"word":"the","charStart":56,"charEnd":59,"startMs":3780,"endMs":3980},{"word":"librarian","charStart":60,"charEnd":69,"startMs":3980,"endMs":4260}]},{"id":"daily-210-the-thank-you-assembly-p4-s3","ord":2,"text":"\"These people work so hard for us every day,\" said Mina.","translation_ko":"\"이분들이 매일 우리를 위해 정말 열심히 일하시잖아,\" 미나가 말했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p4-s3.mp3","wordTimings":[{"word":"These","charStart":1,"charEnd":6,"startMs":0,"endMs":800},{"word":"people","charStart":7,"charEnd":13,"startMs":800,"endMs":1240},{"word":"work","charStart":14,"charEnd":18,"startMs":1240,"endMs":1780},{"word":"so","charStart":19,"charEnd":21,"startMs":1780,"endMs":2280},{"word":"hard","charStart":22,"charEnd":26,"startMs":2280,"endMs":2480},{"word":"for","charStart":27,"charEnd":30,"startMs":2480,"endMs":2660},{"word":"us","charStart":31,"charEnd":33,"startMs":2660,"endMs":2900},{"word":"every","charStart":34,"charEnd":39,"startMs":2900,"endMs":3160},{"word":"day","charStart":40,"charEnd":43,"startMs":3160,"endMs":4100},{"word":"said","charStart":46,"charEnd":50,"startMs":4100,"endMs":4100},{"word":"Mina","charStart":51,"charEnd":55,"startMs":4100,"endMs":4300}]}]},{"id":"daily-210-the-thank-you-assembly-p5","pageNo":5,"spread":"p5","imageUrl":"/seed/daily-210-the-thank-you-assembly/p5.webp","sentences":[{"id":"daily-210-the-thank-you-assembly-p5-s1","ord":0,"text":"Next, they decided what each student would do at the assembly.","translation_ko":"다음으로, 발표회에서 각 학생이 무엇을 할지 결정했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p5-s1.mp3","wordTimings":[{"word":"Next","charStart":0,"charEnd":4,"startMs":0,"endMs":440},{"word":"they","charStart":6,"charEnd":10,"startMs":560,"endMs":960},{"word":"decided","charStart":11,"charEnd":18,"startMs":960,"endMs":1360},{"word":"what","charStart":19,"charEnd":23,"startMs":1360,"endMs":1640},{"word":"each","charStart":24,"charEnd":28,"startMs":1640,"endMs":1900},{"word":"student","charStart":29,"charEnd":36,"startMs":1900,"endMs":2240},{"word":"would","charStart":37,"charEnd":42,"startMs":2240,"endMs":2500},{"word":"do","charStart":43,"charEnd":45,"startMs":2500,"endMs":2680},{"word":"at","charStart":46,"charEnd":48,"startMs":2680,"endMs":2900},{"word":"the","charStart":49,"charEnd":52,"startMs":2900,"endMs":3120},{"word":"assembly","charStart":53,"charEnd":61,"startMs":3120,"endMs":3340}]},{"id":"daily-210-the-thank-you-assembly-p5-s2","ord":1,"text":"Some would give short speeches, and others would sing a song.","translation_ko":"몇몇은 짧은 연설을 하고, 나머지는 노래를 부르기로 했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p5-s2.mp3","wordTimings":[{"word":"Some","charStart":0,"charEnd":4,"startMs":0,"endMs":440},{"word":"would","charStart":5,"charEnd":10,"startMs":440,"endMs":820},{"word":"give","charStart":11,"charEnd":15,"startMs":820,"endMs":1000},{"word":"short","charStart":16,"charEnd":21,"startMs":1000,"endMs":1380},{"word":"speeches","charStart":22,"charEnd":30,"startMs":1380,"endMs":1800},{"word":"and","charStart":32,"charEnd":35,"startMs":2300,"endMs":2500},{"word":"others","charStart":36,"charEnd":42,"startMs":2500,"endMs":2720},{"word":"would","charStart":43,"charEnd":48,"startMs":2720,"endMs":3040},{"word":"sing","charStart":49,"charEnd":53,"startMs":3040,"endMs":3160},{"word":"a","charStart":54,"charEnd":55,"startMs":3160,"endMs":3600},{"word":"song","charStart":56,"charEnd":60,"startMs":3600,"endMs":3600}]}]},{"id":"daily-210-the-thank-you-assembly-p6","pageNo":6,"spread":"p6","imageUrl":"/seed/daily-210-the-thank-you-assembly/p6.webp","sentences":[{"id":"daily-210-the-thank-you-assembly-p6-s1","ord":0,"text":"Jun practiced his speech every evening at home.","translation_ko":"Jun은 매일 저녁 집에서 연설을 연습했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p6-s1.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":460},{"word":"practiced","charStart":4,"charEnd":13,"startMs":460,"endMs":1020},{"word":"his","charStart":14,"charEnd":17,"startMs":1020,"endMs":1300},{"word":"speech","charStart":18,"charEnd":24,"startMs":1300,"endMs":1560},{"word":"every","charStart":25,"charEnd":30,"startMs":1560,"endMs":1960},{"word":"evening","charStart":31,"charEnd":38,"startMs":1960,"endMs":2280},{"word":"at","charStart":39,"charEnd":41,"startMs":2280,"endMs":2540},{"word":"home","charStart":42,"charEnd":46,"startMs":2540,"endMs":2720}]},{"id":"daily-210-the-thank-you-assembly-p6-s2","ord":1,"text":"\"Thank you, Ms. Park, for teaching us so patiently,\" he repeated until it felt natural.","translation_ko":"\"박 선생님, 인내심 있게 가르쳐 주셔서 감사해요,\"라고 자연스러워질 때까지 반복했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p6-s2.mp3","wordTimings":[{"word":"Thank","charStart":1,"charEnd":6,"startMs":0,"endMs":440},{"word":"you","charStart":7,"charEnd":10,"startMs":440,"endMs":660},{"word":"Ms","charStart":12,"charEnd":14,"startMs":720,"endMs":920},{"word":"Park","charStart":16,"charEnd":20,"startMs":920,"endMs":1240},{"word":"for","charStart":22,"charEnd":25,"startMs":1400,"endMs":1700},{"word":"teaching","charStart":26,"charEnd":34,"startMs":1700,"endMs":1980},{"word":"us","charStart":35,"charEnd":37,"startMs":1980,"endMs":2300},{"word":"so","charStart":38,"charEnd":40,"startMs":2300,"endMs":2640},{"word":"patiently","charStart":41,"charEnd":50,"startMs":2640,"endMs":3820},{"word":"he","charStart":53,"charEnd":55,"startMs":3820,"endMs":3960},{"word":"repeated","charStart":56,"charEnd":64,"startMs":3960,"endMs":4400},{"word":"until","charStart":65,"charEnd":70,"startMs":4400,"endMs":4980},{"word":"it","charStart":71,"charEnd":73,"startMs":4980,"endMs":5260},{"word":"felt","charStart":74,"charEnd":78,"startMs":5260,"endMs":5400},{"word":"natural","charStart":79,"charEnd":86,"startMs":5400,"endMs":5820}]}]},{"id":"daily-210-the-thank-you-assembly-p7","pageNo":7,"spread":"p7","imageUrl":"/seed/daily-210-the-thank-you-assembly/p7.webp","sentences":[{"id":"daily-210-the-thank-you-assembly-p7-s1","ord":0,"text":"On the morning of the assembly, Jun felt nervous.","translation_ko":"발표회 당일 아침, Jun은 긴장이 되었어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p7-s1.mp3","wordTimings":[{"word":"On","charStart":0,"charEnd":2,"startMs":0,"endMs":240},{"word":"the","charStart":3,"charEnd":6,"startMs":240,"endMs":400},{"word":"morning","charStart":7,"charEnd":14,"startMs":400,"endMs":720},{"word":"of","charStart":15,"charEnd":17,"startMs":720,"endMs":880},{"word":"the","charStart":18,"charEnd":21,"startMs":880,"endMs":1100},{"word":"assembly","charStart":22,"charEnd":30,"startMs":1100,"endMs":1420},{"word":"Jun","charStart":32,"charEnd":35,"startMs":2000,"endMs":2240},{"word":"felt","charStart":36,"charEnd":40,"startMs":2240,"endMs":2600},{"word":"nervous","charStart":41,"charEnd":48,"startMs":2600,"endMs":2900}]},{"id":"daily-210-the-thank-you-assembly-p7-s2","ord":1,"text":"\"What if I forget my words?\" he whispered to Mina.","translation_ko":"\"내가 대사를 잊어버리면 어떡하지?\" 그가 미나에게 작은 목소리로 말했어요.","audioUrl":"/seed/daily-210-the-thank-you-assembly/audio/p7-s2.mp3","wordTimings":[{"word":"What","charStart":1,"charEnd":5,"startMs":0,"endMs":360},{"word":"if","charStart":6,"charEnd":8,"startMs":360,"endMs":820},{"word":"I","charStart":9,"charEnd":10,"startMs":820,"endMs":1540},{"word":"forget","charStart":11,"charEnd":17,"startMs":1540,"endMs":1940},{"word":"my","charStart":18,"charEnd":20,"startMs":1940,"endMs":2320},{"word":"words","charStart":21,"charEnd":26,"startMs":2320,"endMs":2740},{"word":"he","charStart":29,"charEnd":31,"startMs":3540,"endMs":3740},{"word":"whispered","charStart":32,"charEnd":41,"startMs":3740,"endMs":4160},{"word":"to","charStart":42,"charEnd":44,"startMs":4160,"endMs":4380},{"word":"Mina","charStart":45,"charEnd":49,"startMs":4380,"endMs":4540}]},{"id":"daily-210-the-thank-you-assembly-p7-s3","ord":2,"text":"\"Just speak from your heart,\" Mina replied with a smile.","translation