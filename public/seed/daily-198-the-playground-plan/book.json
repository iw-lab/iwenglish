":0,"charEnd":4,"startMs":0,"endMs":260},{"word":"also","charStart":5,"charEnd":9,"startMs":260,"endMs":620},{"word":"agreed","charStart":10,"charEnd":16,"startMs":620,"endMs":920},{"word":"to","charStart":17,"charEnd":19,"startMs":920,"endMs":1220},{"word":"install","charStart":20,"charEnd":27,"startMs":1220,"endMs":1580},{"word":"a","charStart":28,"charEnd":29,"startMs":1580,"endMs":1900},{"word":"shade","charStart":30,"charEnd":35,"startMs":1900,"endMs":2140},{"word":"sail","charStart":36,"charEnd":40,"startMs":2140,"endMs":2440}]},{"id":"daily-198-the-playground-plan-p10-s3","ord":2,"text":"Jun and Mina could not believe their plan had worked.","translation_ko":"준과 미나는 자신들의 제안이 실현된 것이 믿기지 않았다.","audioUrl":"/seed/daily-198-the-playground-plan/audio/p10-s3.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":480},{"word":"and","charStart":4,"charEnd":7,"startMs":480,"endMs":820},{"word":"Mina","charStart":8,"charEnd":12,"startMs":820,"endMs":1100},{"word":"could","charStart":13,"charEnd":18,"startMs":1100,"endMs":1660},{"word":"not","charStart":19,"charEnd":22,"startMs":1660,"endMs":2080},{"word":"believe","charStart":23,"charEnd":30,"startMs":2080,"endMs":2420},{"word":"their","charStart":31,"charEnd":36,"startMs":2420,"endMs":2680},{"word":"plan","charStart":37,"charEnd":41,"startMs":2680,"endMs":2940},{"word":"had","charStart":42,"charEnd":45,"startMs":2940,"endMs":3180},{"word":"worked","charStart":46,"charEnd":52,"startMs":3180,"endMs":3440}]}]},{"id":"daily-198-the-playground-plan-p11","pageNo":11,"spread":"p11","imageUrl":"/seed/daily-198-the-playground-plan/p11.webp","sentences":[{"id":"daily-198-the-playground-plan-p11-s1","ord":0,"text":"Two weeks later, workers came to set up the equipment.","translation_ko":"이 주 후, 일꾼들이 와서 기구를 설치했다.","audioUrl":"/seed/daily-198-the-playground-plan/audio/p11-s1.mp3","wordTimings":[{"word":"Two","charStart":0,"charEnd":3,"startMs":0,"endMs":320},{"word":"weeks","charStart":4,"charEnd":9,"startM