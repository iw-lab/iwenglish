":"p10","imageUrl":"/seed/daily-209-the-welcome-guide/p10.webp","sentences":[{"id":"daily-209-the-welcome-guide-p10-s1","ord":0,"text":"\"Should we write about what happens when you feel lonely?\" Mina asked quietly.","translation_ko":"\"외로울 때 어떻게 하는지도 써야 할까?\" 미나가 조용히 물었어요.","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p10-s1.mp3","wordTimings":[{"word":"Should","charStart":1,"charEnd":7,"startMs":0,"endMs":280},{"word":"we","charStart":8,"charEnd":10,"startMs":280,"endMs":520},{"word":"write","charStart":11,"charEnd":16,"startMs":520,"endMs":780},{"word":"about","charStart":17,"charEnd":22,"startMs":780,"endMs":1100},{"word":"what","charStart":23,"charEnd":27,"startMs":1100,"endMs":1420},{"word":"happens","charStart":28,"charEnd":35,"startMs":1420,"endMs":1780},{"word":"when","charStart":36,"charEnd":40,"startMs":1780,"endMs":2020},{"word":"you","charStart":41,"charEnd":44,"startMs":2020,"endMs":2200},{"word":"feel","charStart":45,"charEnd":49,"startMs":2200,"endMs":2460},{"word":"lonely","charStart":50,"charEnd":56,"startMs":2460,"endMs":2800},{"word":"Mina","charStart":59,"charEnd":63,"startMs":3520,"endMs":3580},{"word":"asked","charStart":64,"charEnd":69,"startMs":3580,"endMs":3920},{"word":"quietly","charStart":70,"charEnd":77,"startMs":3920,"endMs":4300}]},{"id":"daily-209-the-welcome-guide-p10-s2","ord":1,"text":"Jun nodded. \"Yes, because starting a new school can be scary.\"","translation_ko":"준이 고개를 끄덕였어요. \"응, 새 학교를 시작하면 무서울 수 있으니까.\"","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p10-s2.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":360},{"word":"nodded","charStart":4,"charEnd":10,"startMs":360,"endMs":1080},{"word":"Yes","charStart":13,"charEnd":16,"startMs":1400,"endMs":1720},{"word":"because","charStart":18,"charEnd":25,"startMs":2140,"endMs":2420},{"word":"starting","charStart":26,"charEnd":34,"startMs":2420,"endMs":2660},{"word":"a","charStart":35,"charEnd":36,"startMs":2660,"endMs":2900},{"word":"new","charStart":37,"charEnd":40,"startMs":2900,"endMs":3100},{"word":"school","charStart":41,"charEnd":47,"startMs":3100,"endMs":3320},{"word":"can","charStart":48,"charEnd":51,"startMs":3320,"endMs":3560},{"word":"be","charStart":52,"charEnd":54,"startMs":3560,"endMs":3820},{"word":"scary","charStart":55,"charEnd":60,"startMs":3820,"endMs":4100}]},{"id":"daily-209-the-welcome-guide-p10-s3","ord":2,"text":"They wrote, \"If you feel lost, talk to your teacher — she will always help.\"","translation_ko":"두 사람은 적었어요. \"막막하면 선생님께 말해요. 선생님은 항상 도와주실 거예요.\"","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p10-s3.mp3","wordTimings":[{"word":"They","charStart":0,"charEnd":4,"startMs":0,"endMs":260},{"word":"wrote","charStart":5,"charEnd":10,"startMs":260,"endMs":500},{"word":"If","charStart":13,"charEnd":15,"startMs":920,"endMs":1020},{"word":"you","charStart":16,"charEnd":19,"startMs":1020,"endMs":1220},{"word":"feel","charStart":20,"charEnd":24,"startMs":1220,"endMs":1420},{"word":"lost","charStart":25,"charEnd":29,"startMs":1420,"endMs":1760},{"word":"talk","charStart":31,"charEnd":35,"startMs":2160,"endMs":2180},{"word":"to","charStart":36,"charEnd":38,"startMs":2180,"endMs":2340},{"word":"your","charStart":39,"charEnd":43,"startMs":2340,"endMs":2520},{"word":"teacher","charStart":44,"charEnd":51,"startMs":2520,"endMs":2820},{"word":"she","charStart":54,"charEnd":57,"startMs":3200,"endMs":3240},{"word":"will","charStart":58,"charEnd":62,"startMs":3240,"endMs":3420},{"word":"always","charStart":63,"charEnd":69,"startMs":3420,"endMs":3780},{"word":"help","charStart":70,"charEnd":74,"startMs":3780,"endMs":4020}]}]},{"id":"daily-209-the-welcome-guide-p11","pageNo":11,"spread":"p11","imageUrl":"/seed/daily-209-the-welcome-guide/p11.webp","sentences":[{"id":"daily-209-the-welcome-guide-p11-s1","ord":0,"text":"By the end of the day, the guide was almost finished.","translation_ko":"하루가 끝날 무렵, 안내서가 거의 완성되었어요.","audioUrl":"/seed/daily-209-the-welcome-guide/audio/p11-s1.mp3","wor