","charStart":11,"charEnd":13,"startMs":900,"endMs":1060},{"word":"on","charStart":14,"charEnd":16,"startMs":1060,"endMs":1180},{"word":"her","charStart":17,"charEnd":20,"startMs":1180,"endMs":1400},{"word":"desk","charStart":21,"charEnd":25,"startMs":1400,"endMs":1680},{"word":"and","charStart":26,"charEnd":29,"startMs":1680,"endMs":2260},{"word":"smiled","charStart":30,"charEnd":36,"startMs":2260,"endMs":2540},{"word":"at","charStart":37,"charEnd":39,"startMs":2540,"endMs":2760},{"word":"the","charStart":40,"charEnd":43,"startMs":2760,"endMs":2980},{"word":"students","charStart":44,"charEnd":52,"startMs":2980,"endMs":3240}]},{"id":"daily-197-the-blanket-drive-p1-s3","ord":2,"text":"\"We have something special to do this week,\" she announced.","translation_ko":"\"이번 주에 특별한 일을 할 거예요,\" 선생님이 말씀하셨어요.","audioUrl":"/seed/daily-197-the-blanket-drive/audio/p1-s3.mp3","wordTimings":[{"word":"We","charStart":1,"charEnd":3,"startMs":0,"endMs":240},{"word":"have","charStart":4,"charEnd":8,"startMs":240,"endMs":580},{"word":"something","charStart":9,"charEnd":18,"startMs":580,"endMs":960},{"word":"special","charStart":19,"charEnd":26,"startMs":960,"endMs":1440},{"word":"to","charStart":27,"charEnd":29,"startMs":1440,"endMs":1660},{"word":"do","charStart":30,"charEnd":32,"startMs":1660,"endMs":1840},{"word":"this","charStart":33,"charEnd":37,"startMs":1840,"endMs":2060},{"word":"week","charStart":38,"charEnd":42,"startMs":2060,"endMs":2920},{"word":"she","charStart":45,"charEnd":48,"startMs":2920,"endMs":3080},{"word":"announced","charStart":49,"charEnd":58,"startMs":3080,"endMs":3400}]}]},{"id":"daily-197-the-blanket-drive-p2","pageNo":2,"spread":"p2","imageUrl":"/seed/daily-197-the-blanket-drive/p2.webp","sentences":[{"id":"daily-197-the-blanket-drive-p2-s1","ord":0,"text":"\"Our neighborhood has a blanket drive for elderly people,\" Ms. Park explained.","translation_ko":"\"우리 동네에서 어르신들을 위한 담요 나눔 행사를 해요,\" Park 선생님이 설명하셨어요.","audioUrl":"/seed/daily-197-the-blanket-drive/audio/p2-s1.mp3","wordTimings":[{"word":"Our","charStart":1,"charEnd":4,"startMs":0,"endMs":580},{"word":"neighborhood","charStart":5,"charEnd":17,"startMs":580,"endMs":1020},{"word":"has","charStart":18,"charEnd":21,"startMs":1020,"endMs":1320},{"word":"a","charStart":22,"charEnd":23,"startMs":1320,"endMs":1620},{"word":"blanket","charStart":24,"charEnd":31,"startMs":1620,"endMs":1800},{"word":"drive","charStart":32,"charEnd":37,"startMs":1800,"endMs":2160},{"word":"for","charStart":38,"charEnd":41,"startMs":2160,"endMs":2500},{"word":"elderly","charStart":42,"charEnd":49,"startMs":2500,"endMs":2880},{"word":"people","charStart":50,"charEnd":56,"startMs":2880,"endMs":3860},{"word":"Ms","charStart":59,"charEnd":61,"startMs":3860,"endMs":3900},{"word":"Park","charStart":63,"charEnd":67,"startMs":4080,"endMs":4140},{"word":"explained","charStart":68,"charEnd":77,"startMs":4140,"endMs":4620}]},{"id":"daily-197-the-blanket-drive-p2-s2","ord":1,"text":"\"Winter is coming, and many grandparents need warm blankets.\"","translation_ko":"\"겨울이 다가오고 있어서, 많은 어르신들이 따뜻한 담요가 필요하답니다.\"","audioUrl":"/seed/daily-197-the-blanket-drive/audio/p2-s2.mp3","wordTimings":[{"word":"Winter","charStart":1,"charEnd":7,"startMs":0,"endMs":320},{"word":"is","charStart":8,"charEnd":10,"startMs":320,"endMs":580},{"word":"coming","charStart":11,"charEnd":17,"startMs":580,"endMs":880},{"word":"and","charStart":19,"charEnd":22,"startMs":1460,"endMs":1540},{"word":"many","charStart":23,"charEnd":27,"startMs":1540,"endMs":1760},{"word":"grandparents","charStart":28,"charEnd":40,"startMs":1760,"endMs":2260},{"word":"need","charStart":41,"charEnd":45,"startMs":2260,"endMs":2600},{"word":"warm","charStart":46,"charEnd":50,"startMs":2600,"endMs":2920},{"word":"blankets","charStart":51,"charEnd":59,"startMs":2920,"endMs":3220}]},{"id":"daily-197-the-blanket-drive-p2-s3","ord":2,"text":"Jun raised his hand right away.","translation_ko":"Jun이 바로 손을 들었어요.","audioUrl":"/seed/daily-197-the-blanket-drive/audio/p2-s3.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":480},{"word":"raised","charStart":4,"charEnd":10,"startMs":480,"endMs":840},{"word":"his","charStart":11,"charEnd":14,"startMs":840,"endMs":1160},{"word":"hand","charStart":15,"charEnd":19,"startMs":1160,"endMs":1420},{"word":"right","charStart":20,"charEnd":25,"startMs":1420,"endMs":1780},{"word":"away","charStart":26,"charEnd":30,"startMs":1780,"endMs":2000}]}]},{"id":"daily-197-the-blanket-drive-p3","pageNo":3,"spread":"p3","imageUrl":"/seed/daily-197-the-blanket-drive/p3.webp","sentences":[{"id":"daily-197-the-blanket-drive-p3-s1","ord":0,"text":"\"Can we collect blankets from our families?\" Jun asked eagerly.","translation_ko":"\"저희 가족들에게 담요를 모아도 될까요?\" Jun이 설레는 목소리로 물었어요.","audioUrl":"/seed/daily-197-the-blanket-drive/audio/p3-s1.mp3","wordTimings":[{"word":"Can","charStart":1,"charEnd":4,"startMs":0,"endMs":220},{"word":"we","charStart":5,"charEnd":7,"startMs":220,"endMs":520},{"word":"collect","charStart":8,"charEnd":15,"startMs":520,"endMs":840},{"word":"blankets","charStart":16,"charEnd":24,"startMs":840,"endMs":1360},{"word":"from","charStart":25,"charEnd":29,"startMs":1360,"endMs":1640},{"word":"our","charStart":30,"charEnd":33,"startMs":1640,"endMs":1840},{"word":"families","charStart":34,"charEnd":42,"startMs":1840,"endMs":2340},{"word":"Jun","charStart":45,"charEnd":48,"startMs":2860,"endMs":3080},{"word":"asked","charStart":49,"charEnd":54,"startMs":3080,"endMs":3440},{"word":"eagerly","charStart":55,"charEnd":62,"startMs":3440,"endMs":3980}]},{"id":"daily-197-the-blanket-drive-p3-s2","ord":1,"text":"\"That is exactly the plan,\" said Ms. Park with a nod.","translation_ko":"\"바로 그게 계획이에요,\" Park 선생님이 고개를 끄덕이며 말씀하셨어요.","audioUrl":"/seed/daily-197-the-blanket-drive/audio/p3-s2.mp3","wordTimings":[{"word":"That","charStart":1,"charEnd":5,"startMs":0,"endMs":640},{"word":"is","charStart":6,"charEnd":8,"startMs":640,"endMs":860},{"word":"exactly","charStart":9,"charEnd":16,"s