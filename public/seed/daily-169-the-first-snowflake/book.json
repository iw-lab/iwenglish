:1780},{"word":"cold","charStart":21,"charEnd":25,"startMs":1780,"endMs":2300},{"word":"she","charStart":28,"charEnd":31,"startMs":2300,"endMs":2500},{"word":"said","charStart":32,"charEnd":36,"startMs":2500,"endMs":2760}]}]},{"id":"daily-169-the-first-snowflake-p7","pageNo":7,"spread":"p7","imageUrl":"/seed/daily-169-the-first-snowflake/p7.webp","sentences":[{"id":"daily-169-the-first-snowflake-p7-s1","ord":0,"text":"\"Just one more, Mom!\" said Jun.","translation_ko":"\"하나만 더요, 엄마!\" Jun이 말했어요.","audioUrl":"/seed/daily-169-the-first-snowflake/audio/p7-s1.mp3","wordTimings":[{"word":"Just","charStart":1,"charEnd":5,"startMs":0,"endMs":320},{"word":"one","charStart":6,"charEnd":9,"startMs":320,"endMs":640},{"word":"more","charStart":10,"charEnd":14,"startMs":640,"endMs":900},{"word":"Mom","charStart":16,"charEnd":19,"startMs":1160,"endMs":1700},{"word":"said","charStart":22,"charEnd":26,"startMs":1700,"endMs":1860},{"word":"Jun","charStart":27,"charEnd":30,"startMs":1860,"endMs":2140}]},{"id":"daily-169-the-first-snowflake-p7-s2","ord":1,"text":"He held out his hand again.","translation_ko":"그는 다시 손을 내밀었어요.","audioUrl":"/seed/daily-169-the-first-snowflake/audio/p7-s2.mp3","wordTimings":[{"word":"He","charStart":0,"charEnd":2,"startMs":0,"endMs":660},{"word":"held","charStart":3,"charEnd":7,"startMs":660,"endMs":840},{"word":"out","charStart":8,"charEnd":11,"startMs":840,"endMs":1100},{"word":"his","charStart":12,"charEnd":15,"startMs":1100,"endMs":1360},{"word":"hand","charStart":16,"charEnd":20,"startMs":1360,"endMs":1580},{"word":"again","charStart":21,"charEnd":26,"startMs":1580,"endMs":1900}]}]},{"id":"daily-169-the-first-snowflake-p8","pageNo":8,"spread":"p8","imageUrl":"/seed/daily-169-the-first-snowflake/p8.webp","sentences":[{"id":"daily-169-the-first-snowflake-p8-s1","ord":0,"text":"A big snowflake landed on his fingers.","translation_ko":"커다란 눈송이가 그의 손가락 위에 내려앉았어요.","audioUrl":"/seed/daily-169-the-first-snowflake/audio/p8-s1.mp3","wordTimings":[{"word":"A"