Ms":3760}]},{"id":"daily-205-the-walkathon-for-trees-p7-s3","ord":2,"text":"\"You've already done so well — every step counts!\"","translation_ko":"\"이미 정말 잘하고 있어요 — 한 걸음 한 걸음이 모두 소중하답니다!\"","audioUrl":"/seed/daily-205-the-walkathon-for-trees/audio/p7-s3.mp3","wordTimings":[{"word":"You've","charStart":1,"charEnd":7,"startMs":0,"endMs":360},{"word":"already","charStart":8,"charEnd":15,"startMs":360,"endMs":780},{"word":"done","charStart":16,"charEnd":20,"startMs":780,"endMs":980},{"word":"so","charStart":21,"charEnd":23,"startMs":980,"endMs":1420},{"word":"well","charStart":24,"charEnd":28,"startMs":1420,"endMs":1680},{"word":"every","charStart":31,"charEnd":36,"startMs":2080,"endMs":2340},{"word":"step","charStart":37,"charEnd":41,"startMs":2340,"endMs":2580},{"word":"counts","charStart":42,"charEnd":48,"startMs":2580,"endMs":2960}]}]},{"id":"daily-205-the-walkathon-for-trees-p8","pageNo":8,"spread":"p8","imageUrl":"/seed/daily-205-the-walkathon-for-trees/p8.webp","sentences":[{"id":"daily-205-the-walkathon-for-trees-p8-s1","ord":0,"text":"After the break, Jun felt much better and started walking again.","translation_ko":"잠깐 쉬고 나자 준은 한결 나아진 기분이 들어 다시 걷기 시작했어요.","audioUrl":"/seed/daily-205-the-walkathon-for-trees/audio/p8-s1.mp3","wordTimings":[{"word":"After","charStart":0,"charEnd":5,"startMs":0,"endMs":300},{"word":"the","charStart":6,"charEnd":9,"startMs":300,"endMs":500},{"word":"break","charStart":10,"charEnd":15,"startMs":500,"endMs":760},{"word":"Jun","charStart":17,"charEnd":20,"startMs":1160,"endMs":1300},{"word":"felt","charStart":21,"charEnd":25,"startMs":1300,"endMs":1560},{"word":"much","charStart":26,"charEnd":30,"startMs":1560,"endMs":1880},{"word":"better","charStart":31,"charEnd":37,"startMs":1880,"endMs":2140},{"word":"and","charStart":38,"charEnd":41,"startMs":2140,"endMs":2640},{"word":"started","charStart":42,"charEnd":49,"startMs":2640,"endMs":2960},{"word":"walking","charStart":50,"charEnd":57,"startMs":2960,"endMs":3280},{"word":"again","cha