dMs":2820}]},{"id":"daily-207-the-world-food-day-p2-s2","ord":1,"text":"\"I want to try food from every country!\" he said.","translation_ko":"\"모든 나라 음식을 다 먹어보고 싶어요!\"라고 준이 말했어요.","audioUrl":"/seed/daily-207-the-world-food-day/audio/p2-s2.mp3","wordTimings":[{"word":"I","charStart":1,"charEnd":2,"startMs":0,"endMs":240},{"word":"want","charStart":3,"charEnd":7,"startMs":240,"endMs":560},{"word":"to","charStart":8,"charEnd":10,"startMs":560,"endMs":780},{"word":"try","charStart":11,"charEnd":14,"startMs":780,"endMs":1080},{"word":"food","charStart":15,"charEnd":19,"startMs":1080,"endMs":1360},{"word":"from","charStart":20,"charEnd":24,"startMs":1360,"endMs":1640},{"word":"every","charStart":25,"charEnd":30,"startMs":1640,"endMs":2040},{"word":"country","charStart":31,"charEnd":38,"startMs":2040,"endMs":2440},{"word":"he","charStart":41,"charEnd":43,"startMs":2440,"endMs":2580},{"word":"said","charStart":44,"charEnd":48,"startMs":2580,"endMs":2840}]},{"id":"daily-207-the-world-food-day-p2-s3","ord":2,"text":"Mina smiled and nodded. \"Me too!\"","translation_ko":"미나는 웃으며 고개를 끄덕였어요. \"저도요!\"","audioUrl":"/seed/daily-207-the-world-food-day/audio/p2-s3.mp3","wordTimings":[{"word":"Mina","charStart":0,"charEnd":4,"startMs":0,"endMs":460},{"word":"smiled","charStart":5,"charEnd":11,"startMs":460,"endMs":1320},{"word":"and","charStart":12,"charEnd":15,"startMs":1320,"endMs":1820},{"word":"nodded","charStart":16,"charEnd":22,"startMs":1820,"endMs":2020},{"word":"Me","charStart":25,"charEnd":27,"startMs":2600,"endMs":2860},{"word":"too","charStart":28,"charEnd":31,"startMs":2860,"endMs":3140}]}]},{"id":"daily-207-the-world-food-day-p3","pageNo":3,"spread":"p3","imageUrl":"/seed/daily-207-the-world-food-day/p3.webp","sentences":[{"id":"daily-207-the-world-food-day-p3-s1","ord":0,"text":"Ms. Park told the students to bring food from home.","translation_ko":"박 선생님은 학생들에게 집에서 음식을 가져오라고 하셨어요.","audioUrl":"/seed/daily-207-the-world-food-day/audio/p3-s1.mp3","wordTimings":[{"word":"Ms","charStart":0,"charEnd":2,"startMs":0,"endMs":780},{"word":"Park","charStart":4,"charEnd":8,"startMs":1000,"endMs":1120},{"word":"told","charStart":9,"charEnd":13,"startMs":1120,"endMs":1620},{"word":"the","charStart":14,"charEnd":17,"startMs":1620,"endMs":1820},{"word":"students","charStart":18,"charEnd":26,"startMs":1820,"endMs":2140},{"word":"to","charStart":27,"charEnd":29,"startMs":2140,"endMs":2420},{"word":"bring","charStart":30,"charEnd":35,"startMs":2420,"endMs":2580},{"word":"food","charStart":36,"charEnd":40,"startMs":2580,"endMs":2900},{"word":"from","charStart":41,"charEnd":45,"startMs":2900,"endMs":3160},{"word":"home","charStart":46,"charEnd":50,"startMs":3160,"endMs":3400}]},{"id":"daily-207-the-world-food-day-p3-s2","ord":1,"text":"\"We will share and learn about each other's cultures,\" she explained.","translation_ko":"\"서로의 문화에 대해 나누고 배울 거예요.\"라고 선생님이 설명하셨어요.","audioUrl":"/seed/daily-207-the-world-food-day/audio/p3-s2.mp3","wordTimings":[{"word":"We","charStart":1,"charEnd":3,"startMs":0,"endMs":220},{"word":"will","charStart":4,"charEnd":8,"startMs":220,"endMs":580},{"word":"share","charStart":9,"charEnd":14,"startMs":580,"endMs":900},{"word":"and","charStart":15,"charEnd":18,"startMs":900,"endMs":1260},{"word":"learn","charStart":19,"charEnd":24,"startMs":1260,"endMs":1500},{"word":"about","charStart":25,"charEnd":30,"startMs":1500,"endMs":1760},{"word":"each","charStart":31,"charEnd":35,"startMs":1760,"endMs":2000},{"word":"other's","charStart":36,"charEnd":43,"startMs":2000,"endMs":2440},{"word":"cultures","charStart":44,"charEnd":52,"startMs":2440,"endMs":3360},{"word":"she","charStart":55,"charEnd":58,"startMs":3360,"endMs":3580},{"word":"explained","charStart":59,"charEnd":68,"startMs":3580,"endMs":3920}]}]},{"id":"daily-207-the-world-food-day-p4","pageNo":4,"spread":"p4","imageUrl":"/seed/daily-207-the-world-food-day/p4.webp","sentences":[{"id":"daily-207-the-world-food-day-p4-s1","ord":0,"text":"The next day, the classroom smelled amazing.","translation_ko":"다음 날, 교실에서 맛있는 냄새가 났어요.","audioUrl":"/seed/daily-207-the-world-food-day/audio/p4-s1.mp3","wordTimings":[{"word":"The","charStart":0,"charEnd":3,"startMs":0,"endMs":600},{"word":"next","charStart":4,"charEnd":8,"startMs":600,"endMs":900},{"word":"day","charStart":9,"charEnd":12,"startMs":900,"endMs":1260},{"word":"the","charStart":14,"charEnd":17,"startMs":1480,"endMs":1700},{"word":"classroom","charStart":18,"charEnd":27,"startMs":1700,"endMs":2160},{"word":"smelled","charStart":28,"charEnd":35,"startMs":2160,"endMs":2520},{"word":"amazing","charStart":36,"charEnd":43,"startMs":2520,"endMs":2940}]},{"id":"daily-207-the-world-food-day-p4-s2","ord":1,"text":"There were dishes from Korea, Japan, Mexico, Italy, and India.","translation_ko":"한국, 일본, 멕시코, 이탈리아, 인도 음식들이 있었어요.","audioUrl":"/seed/daily-207-the-world-food-day/audio/p4-s2.mp3","wordTimings":[{"word":"There","charStart":0,"charEnd":5,"startMs":0,"endMs":280},{"word":"were","charStart":6,"charEnd":10,"startMs":280,"endMs":480},{"word":"dishes","charStart":11,"charEnd":17,"startMs":480,"endMs":740},{"word":"from","charStart":18,"charEnd":22,"startMs":740,"endMs":1040},{"word":"Korea","charStart":23,"charEnd":28,"startMs":1040,"endMs":1420},{"word":"Japan","charStart":30,"charEnd":35,"startMs":2300,"endMs":2300},{"word":"Mexico","charStart":37,"charEnd":43,"startMs":2720,"endMs":2980},{"word":"Italy","charStart":45,"charEnd":50,"startMs":3520,"endMs":3680},{"word":"and","charStart":52,"charEnd":55,"startMs":3840,"endMs":4280},{"word":"India","charStart":56,"charEnd":61,"startMs":4280,"endMs":4440}]},{"id":"daily-207-the-world-food-day-p4-s3","ord":2,"text":"Jun brought kimchi jeon that he made with his mom.","translation_ko":"준은 엄마와 함께 만든 김치전을 가져왔어요.","audioUrl":"/seed/daily-207-the-world-food-day/audio/p4-s3.mp3","wordTimings":[{"word":"Jun","charStart":0,"charEnd":3,"startMs":0,"endMs":480},{"word":"brought","charStart":4,"charEnd":11,"startMs":480,"endMs":800},{"word":"kimchi","charSta