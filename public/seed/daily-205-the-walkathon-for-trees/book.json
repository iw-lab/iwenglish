:3540,"endMs":3760}]}]},{"id":"daily-205-the-walkathon-for-trees-p6","pageNo":6,"spread":"p6","imageUrl":"/seed/daily-205-the-walkathon-for-trees/p6.webp","sentences":[{"id":"daily-205-the-walkathon-for-trees-p6-s1","ord":0,"text":"After six laps, Jun's legs felt a little heavy, and he slowed down.","translation_ko":"여섯 바퀴를 돌자 준의 다리가 조금 무거워지기 시작해서 속도를 늦췄어요.","audioUrl":"/seed/daily-205-the-walkathon-for-trees/audio/p6-s1.mp3","wordTimings":[{"word":"After","charStart":0,"charEnd":5,"startMs":0,"endMs":340},{"word":"six","charStart":6,"charEnd":9,"startMs":340,"endMs":800},{"word":"laps","charStart":10,"charEnd":14,"startMs":800,"endMs":1180},{"word":"Jun's","charStart":16,"charEnd":21,"startMs":1620,"endMs":1920},{"word":"legs","charStart":22,"charEnd":26,"startMs":1920,"endMs":2140},{"word":"felt","charStart":27,"charEnd":31,"startMs":2140,"endMs":2420},{"word":"a","charStart":32,"charEnd":33,"startMs":2420,"endMs":2620},{"word":"little","charStart":34,"charEnd":40,"startMs":2620,"endMs":2800},{"word":"heavy","charStart":41,"charEnd":46,"startMs":2800,"endMs":3120},{"word":"and","charStart":48,"charEnd":51,"startMs":3540,"endMs":3600},{"word":"he","charStart":52,"charEnd":54,"startMs":3600,"endMs":3840},{"word":"slowed","charStart":55,"charEnd":61,"startMs":3840,"endMs":4040},{"word":"down","charStart":62,"charEnd":66,"startMs":4040,"endMs":4380}]},{"id":"daily-205-the-walkathon-for-trees-p6-s2","ord":1,"text":"\"Are you okay?\" Mina asked, looking at him with concern.","translation_ko":"\"괜찮아?\" 미나가 걱정스러운 눈빛으로 물었어요.","audioUrl":"/seed/daily-205-the-walkathon-for-trees/audio/p6-s2.mp3","wordTimings":[{"word":"Are","charStart":1,"charEnd":4,"startMs":0,"endMs":340},{"word":"you","charStart":5,"charEnd":8,"startMs":340,"endMs":520},{"word":"okay","charStart":9,"charEnd":13,"startMs":520,"endMs":1000},{"word":"Mina","charStart":16,"charEnd":20,"startMs":1280,"endMs":1460},{"word":"asked","charStart":21,"charEnd":26,"startMs":1460,"endMs":1880},{"word":"looking","charS