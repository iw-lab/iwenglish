1-s1.mp3","wordTimings":[{"word":"They","charStart":0,"charEnd":4,"startMs":0,"endMs":660},{"word":"gathered","charStart":5,"charEnd":13,"startMs":660,"endMs":1020},{"word":"nectar","charStart":14,"charEnd":20,"startMs":1020,"endMs":1480},{"word":"when","charStart":21,"charEnd":25,"startMs":1480,"endMs":1780},{"word":"the","charStart":26,"charEnd":29,"startMs":1780,"endMs":2080},{"word":"afternoon","charStart":30,"charEnd":39,"startMs":2080,"endMs":2400},{"word":"sun","charStart":40,"charEnd":43,"startMs":2400,"endMs":2800},{"word":"shone","charStart":44,"charEnd":49,"startMs":2800,"endMs":3100}]},{"id":"the-honeybees-dance-p11-s2","ord":1,"text":"Bella smiled because her dance had shown the way.","translation_ko":"벨라는 자신의 춤이 길을 알려주었기 때문에 환하게 웃었어요.","audioUrl":"/seed/the-honeybees-dance/audio/p11-s2.mp3","wordTimings":[{"word":"Bella","charStart":0,"charEnd":5,"startMs":0,"endMs":720},{"word":"smiled","charStart":6,"charEnd":12,"startMs":720,"endMs":1280},{"word":"because","charStart":13,"charEnd":20,"startMs":1280,"endMs":2060},{"word":"her","charStart":21,"charEnd":24,"startMs":2060,"endMs":2320},{"word":"dance","charStart":25,"charEnd":30,"startMs":2320,"endMs":2640},{"word":"had","charStart":31,"charEnd":34,"startMs":2640,"endMs":2900},{"word":"shown","charStart":35,"charEnd":40,"startMs":2900,"endMs":3140},{"word":"the","charStart":41,"charEnd":44,"startMs":3140,"endMs":3280},{"word":"way","charStart":45,"charEnd":48,"startMs":3280,"endMs":3520}]}]}],"quiz":[{"question_ko":"벨라가 꽃밭을 발견했을 때 가장 먼저 한 일은 무엇인가요?","type":"mc","options":["꿀을 맛보았어요.","집으로 바로 돌아갔어요.","다른 벌들을 불렀어요.","꽃을 꺾었어요."],"answerIndex":0,"explain_ko":"벨라는 꽃 위에 내려앉아 꿀을 맛보고 기뻐했어요.","id":"the-honeybees-dance-q1","ord":0},{"question_ko":"벨라는 왜 집으로 돌아갔나요?","type":"mc","options":["배가 고파서요.","무서워서요.","친구들에게 꽃밭의 위치를 알려주려고요.","날씨가 나빠져서요."],"answerIndex":2,"explain_ko":"벨라는 친구들도 달콤한 꿀이 필요하다고 생각해 집으로 돌아갔어요.","id":"the-honeybees-dance-q2","ord":1},{"question_ko":"벨라는 어떻게 꽃밭의 방향을 친구들에게 알려주었나요?","type":"mc","opti