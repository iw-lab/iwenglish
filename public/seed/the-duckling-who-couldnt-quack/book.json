{"id":"the-duckling-who-couldnt-quack","slug":"the-duckling-who-couldnt-quack","title":"The Duckling Who Couldn't Quack","title_ko":"꽥 못하는 아기 오리","level":"A1","ageBand":"8-10","coverUrl":"/seed/the-duckling-who-couldnt-quack/cover.webp","summary_ko":"꽥 소리가 안 나오던 아기 오리가 연습 끝에 자기 목소리를 찾는 이야기.","wordCount":108,"pages":[{"id":"the-duckling-who-couldnt-quack-p1","pageNo":1,"spread":"p1","imageUrl":"/seed/the-duckling-who-couldnt-quack/p1.webp","sentences":[{"id":"the-duckling-who-couldnt-quack-p1-s1","ord":0,"text":"Little Duck lived by a blue pond.","translation_ko":"아기 오리는 파란 연못 곁에 살았어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p1-s1.mp3","wordTimings":[{"word":"Little","charStart":0,"charEnd":6,"startMs":0,"endMs":380},{"word":"Duck","charStart":7,"charEnd":11,"startMs":380,"endMs":820},{"word":"lived","charStart":12,"charEnd":17,"startMs":820,"endMs":1300},{"word":"by","charStart":18,"charEnd":20,"startMs":1300,"endMs":1560},{"word":"a","charStart":21,"charEnd":22,"startMs":1560,"endMs":1820},{"word":"blue","charStart":23,"charEnd":27,"startMs":1820,"endMs":2080},{"word":"pond","charStart":28,"charEnd":32,"startMs":2080,"endMs":2460}]}]},{"id":"the-duckling-who-couldnt-quack-p2","pageNo":2,"spread":"p2","imageUrl":"/seed/the-duckling-who-couldnt-quack/p2.webp","sentences":[{"id":"the-duckling-who-couldnt-quack-p2-s1","ord":0,"text":"All the ducks said, \"Quack, quack!\"","translation_ko":"모든 오리들이 \"꽥, 꽥!\" 하고 말했어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p2-s1.mp3","wordTimings":[{"word":"All","charStart":0,"charEnd":3,"startMs":0,"endMs":300},{"word":"the","charStart":4,"charEnd":7,"startMs":300,"endMs":640},{"word":"ducks","charStart":8,"charEnd":13,"startMs":640,"endMs":720},{"word":"said","charStart":14,"charEnd":18,"startMs":720,"endMs":1300},{"word":"Quack","charStart":21,"charEnd":26,"startMs":1400,"endMs":1740},{"word":"quack","charStart":28,"charEnd":33,"startMs":2180,"endMs":2180}]},{"id":"the-duckling-who-couldnt-quack-p2-s2","ord":1,"text":"But Little Duck could only say, \"Peep!\"","translation_ko":"하지만 아기 오리는 \"삐약!\"이라고만 할 수 있었어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p2-s2.mp3","wordTimings":[{"word":"But","charStart":0,"charEnd":3,"startMs":0,"endMs":400},{"word":"Little","charStart":4,"charEnd":10,"startMs":400,"endMs":760},{"word":"Duck","charStart":11,"charEnd":15,"startMs":760,"endMs":980},{"word":"could","charStart":16,"charEnd":21,"startMs":980,"endMs":1260},{"word":"only","charStart":22,"charEnd":26,"startMs":1260,"endMs":1700},{"word":"say","charStart":27,"charEnd":30,"startMs":1700,"endMs":2020},{"word":"Peep","charStart":33,"charEnd":37,"startMs":2680,"endMs":2680}]}]},{"id":"the-duckling-who-couldnt-quack-p3","pageNo":3,"spread":"p3","imageUrl":"/seed/the-duckling-who-couldnt-quack/p3.webp","sentences":[{"id":"the-duckling-who-couldnt-quack-p3-s1","ord":0,"text":"Little Duck felt sad and hid in the reeds.","translation_ko":"아기 오리는 슬퍼서 갈대 속에 숨었어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p3-s1.mp3","wordTimings":[{"word":"Little","charStart":0,"charEnd":6,"startMs":0,"endMs":300},{"word":"Duck","charStart":7,"charEnd":11,"startMs":300,"endMs":540},{"word":"felt","charStart":12,"charEnd":16,"startMs":540,"endMs":860},{"word":"sad","charStart":17,"charEnd":20,"startMs":860,"endMs":1260},{"word":"and","charStart":21,"charEnd":24,"startMs":1260,"endMs":1640},{"word":"hid","charStart":25,"charEnd":28,"startMs":1640,"endMs":1800},{"word":"in","charStart":29,"charEnd":31,"startMs":1800,"endMs":1940},{"word":"the","charStart":32,"charEnd":35,"startMs":1940,"endMs":2040},{"word":"reeds","charStart":36,"charEnd":41,"startMs":2040,"endMs":2340}]}]},{"id":"the-duckling-who-couldnt-quack-p4","pageNo":4,"spread":"p4","imageUrl":"/seed/the-duckling-who-couldnt-quack/p4.webp","sentences":[{"id":"the-duckling-who-couldnt-quack-p4-s1","ord":0,"text":"\"I want to quack,\" said Little Duck.","translation_ko":"\"나도 꽥 하고 싶어요,\" 아기 오리가 말했어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p4-s1.mp3","wordTimings":[{"word":"I","charStart":1,"charEnd":2,"startMs":0,"endMs":160},{"word":"want","charStart":3,"charEnd":7,"startMs":160,"endMs":440},{"word":"to","charStart":8,"charEnd":10,"startMs":440,"endMs":780},{"word":"quack","charStart":11,"charEnd":16,"startMs":780,"endMs":1120},{"word":"said","charStart":19,"charEnd":23,"startMs":1660,"endMs":1720},{"word":"Little","charStart":24,"charEnd":30,"startMs":1720,"endMs":1940},{"word":"Duck","charStart":31,"charEnd":35,"startMs":1940,"endMs":2180}]},{"id":"the-duckling-who-couldnt-quack-p4-s2","ord":1,"text":"She tried again and again.","translation_ko":"아기 오리는 몇 번이고 다시 해 보았어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p4-s2.mp3","wordTimings":[{"word":"She","charStart":0,"charEnd":3,"startMs":0,"endMs":640},{"word":"tried","charStart":4,"charEnd":9,"startMs":640,"endMs":880},{"word":"again","charStart":10,"charEnd":15,"startMs":880,"endMs":1280},{"word":"and","charStart":16,"charEnd":19,"startMs":1280,"endMs":1700},{"word":"again","charStart":20,"charEnd":25,"startMs":1700,"endMs":1940}]}]},{"id":"the-duckling-who-couldnt-quack-p5","pageNo":5,"spread":"p5","imageUrl":"/seed/the-duckling-who-couldnt-quack/p5.webp","sentences":[{"id":"the-duckling-who-couldnt-quack-p5-s1","ord":0,"text":"Little Duck opened her beak very wide.","translation_ko":"아기 오리는 부리를 아주 크게 벌렸어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p5-s1.mp3","wordTimings":[{"word":"Little","charStart":0,"charEnd":6,"startMs":0,"endMs":360},{"word":"Duck","charStart":7,"charEnd":11,"startMs":360,"endMs":640},{"word":"opened","charStart":12,"charEnd":18,"startMs":640,"endMs":1060},{"word":"her","charStart":19,"charEnd":22,"startMs":1060,"endMs":1320},{"word":"beak","charStart":23,"charEnd":27,"startMs":1320,"endMs":1520},{"word":"very","charStart":28,"charEnd":32,"startMs":1520,"endMs":2000},{"word":"wide","charStart":33,"charEnd":37,"startMs":2000,"endMs":2280}]},{"id":"the-duckling-who-couldnt-quack-p5-s2","ord":1,"text":"But only a tiny peep came out.","translation_ko":"하지만 작은 삐약 소리만 나왔어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p5-s2.mp3","wordTimings":[{"word":"But","charStart":0,"charEnd":3,"startMs":0,"endMs":960},{"word":"only","charStart":4,"charEnd":8,"startMs":960,"endMs":1280},{"word":"a","charStart":9,"charEnd":10,"startMs":1280,"endMs":1520},{"word":"tiny","charStart":11,"charEnd":15,"startMs":1520,"endMs":1900},{"word":"peep","charStart":16,"charEnd":20,"startMs":1900,"endMs":2200},{"word":"came","charStart":21,"charEnd":25,"startMs":2200,"endMs":2480},{"word":"out","charStart":26,"charEnd":29,"startMs":2480,"endMs":2720}]}]},{"id":"the-duckling-who-couldnt-quack-p6","pageNo":6,"spread":"p6","imageUrl":"/seed/the-duckling-who-couldnt-quack/p6.webp","sentences":[{"id":"the-duckling-who-couldnt-quack-p6-s1","ord":0,"text":"She practiced every day by the pond.","translation_ko":"아기 오리는 매일 연못 곁에서 연습했어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p6-s1.mp3","wordTimings":[{"word":"She","charStart":0,"charEnd":3,"startMs":0,"endMs":280},{"word":"practiced","charStart":4,"charEnd":13,"startMs":280,"endMs":720},{"word":"every","charStart":14,"charEnd":19,"startMs":720,"endMs":1160},{"word":"day","charStart":20,"charEnd":23,"startMs":1160,"endMs":1360},{"word":"by","charStart":24,"charEnd":26,"startMs":1360,"endMs":1580},{"word":"the","charStart":27,"charEnd":30,"startMs":1580,"endMs":1760},{"word":"pond","charStart":31,"charEnd":35,"startMs":1760,"endMs":2060}]},{"id":"the-duckling-who-couldnt-quack-p6-s2","ord":1,"text":"She did not give up.","translation_ko":"아기 오리는 포기하지 않았어요.","audioUrl":"/seed/the-duckling-who-couldnt-quack/audio/p6-s2.mp3","wordTimings":[{"word":"She","charStart":0,"charEnd":3,"startMs":0,"endMs":400},{"word":"did","charStart":4,"charEnd":7,"startMs":400,"endMs":700},{"word":"not","charStart":8,"charEnd":11,"startMs":700,"endMs":1200},{"word":"give","charStart":12,"charEnd":16,"startMs":1